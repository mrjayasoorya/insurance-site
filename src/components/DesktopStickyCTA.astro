---
/**
 * DesktopStickyCTA.astro
 * Right-side floating action pill — desktop only (min-width: 821px)
 * Shows after 2s scroll or 400px scroll depth.
 * Dual action: Call + WhatsApp.
 */
const {
  brand = {},
} = Astro.props;

const telHref = brand?.phoneE164 ? `tel:${brand.phoneE164}` : "#";
const waHref = brand?.whatsappE164
  ? `https://wa.me/${brand.whatsappE164}?text=${encodeURIComponent(brand?.whatsappPrefill || "Hi, I need insurance guidance. Please help.")}`
  : "#";
const phone = brand?.phone || brand?.phoneE164 || "7448324068";
---

<div class="dscta-wrap" id="dscta" aria-hidden="true" hidden>
  <div class="dscta-pill" role="complementary" aria-label="Quick contact">

    <div class="dscta-header">
      <span class="dscta-dot" aria-hidden="true"></span>
      <span class="dscta-name">Free guidance</span>
    </div>

    <a class="dscta-btn dscta-call" href={telHref} aria-label={`Call ${phone}`}>
      <svg class="dscta-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.71 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.91.35 1.85.58 2.81.71A2 2 0 0 1 22 16.92z"/>
      </svg>
      <div class="dscta-text">
        <span class="dscta-label">Call Now</span>
        <span class="dscta-sub">{phone}</span>
      </div>
    </a>

    <a class="dscta-btn dscta-wa" href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp us">
      <svg class="dscta-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      <div class="dscta-text">
        <span class="dscta-label">WhatsApp</span>
        <span class="dscta-sub">Fast reply</span>
      </div>
    </a>

    <p class="dscta-note">30 yrs · Sholavaram · No commitment</p>
  </div>
</div>

<style is:global>
  .dscta-wrap {
    position: fixed;
    right: 20px;
    bottom: 40px;
    z-index: 9980;
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 280ms ease, transform 280ms ease;
    pointer-events: none;
  }
  .dscta-wrap.visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Only on desktop */
  @media (max-width: 820px) {
    .dscta-wrap { display: none !important; }
  }

  .dscta-pill {
    background: #0b0f19;
    border-radius: 20px;
    padding: 14px 14px 10px;
    width: 190px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.32), 0 2px 8px rgba(0,0,0,0.20);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .dscta-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }
  .dscta-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34,197,94,0.18);
    flex-shrink: 0;
  }
  .dscta-name {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255,255,255,0.60);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dscta-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 10px;
    border-radius: 14px;
    text-decoration: none;
    margin-bottom: 8px;
    transition: transform 80ms ease, opacity 80ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .dscta-btn:active { transform: scale(0.97); opacity: 0.88; }
  .dscta-btn:last-of-type { margin-bottom: 0; }

  .dscta-call {
    background: #ffffff;
    color: #0b0f19;
  }
  .dscta-wa {
    background: #22c55e;
    color: #ffffff;
  }

  .dscta-ico {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .dscta-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .dscta-label {
    font-size: 13px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .dscta-sub {
    font-size: 10.5px;
    font-weight: 600;
    opacity: 0.70;
    line-height: 1;
  }

  .dscta-note {
    margin: 8px 0 0;
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    text-align: center;
    letter-spacing: 0.02em;
  }
</style>

<script>
  (() => {
    if (typeof window === "undefined") return;
    const el = document.getElementById("dscta");
    if (!el) return;

    // Remove hidden attr immediately so transitions work
    el.removeAttribute("hidden");
    el.setAttribute("aria-hidden", "true");

    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      el.setAttribute("aria-hidden", "false");
      el.classList.add("visible");
    }

    // Show after 400px scroll OR 2.5s — whichever comes first
    function onScroll() {
      if (window.scrollY > 400) {
        window.removeEventListener("scroll", onScroll, { passive: true } as AddEventListenerOptions);
        show();
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    setTimeout(show, 2500);
  })();
</script>
