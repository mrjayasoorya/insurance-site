---
/**
 * WhyChooseUs.astro
 * Differentiators section — "Why work with us" — builds trust with proof points.
 * Each point has an accent emoji, title, and description.
 * Props:
 *   title    – section heading
 *   subtitle – optional
 *   points   – array of { icon, title, desc }
 */
const {
  title = "Why work with us",
  subtitle = "",
  points = [],
} = Astro.props;
---

{points.length > 0 && (
  <section class="wcu section section-padding" aria-labelledby="wcu-title">
    <h2 id="wcu-title" class="section-title">{title}</h2>
    {subtitle && <p class="section-sub readable">{subtitle}</p>}

    <div class="wcu-grid">
      {points.map((p) => (
        <div class="wcu-point">
          <div class="wcu-icon">{p.icon}</div>
          <div>
            <h3 class="wcu-heading">{p.title}</h3>
            <p class="wcu-desc">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<style is:inline>
  .wcu-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:14px;
    margin-top:16px;
  }
  .wcu-point{
    display:flex;
    gap:12px;
    padding:16px;
    border:1px solid var(--border);
    border-radius:14px;
    background:var(--surface);
    box-shadow:0 1px 6px rgba(11,13,18,.04);
    align-items:flex-start;
  }
  .wcu-icon{
    flex:0 0 auto;
    width:36px;height:36px;
    border-radius:10px;
    background:#f0fdf4;
    border:1px solid #bbf7d0;
    display:grid;
    place-items:center;
    font-size:18px;
  }
  .wcu-heading{
    margin:0 0 4px;
    font-size:14px;
    font-weight:900;
    line-height:1.3;
  }
  .wcu-desc{
    margin:0;
    font-size:13px;
    line-height:1.45;
    color:var(--muted);
  }

  @media(max-width:820px){
    .wcu-grid{
      grid-template-columns:1fr;
      gap:10px;
    }
    .wcu-point{ padding:14px; }
    .wcu-heading{ font-size:13.5px; }
    .wcu-desc{ font-size:12.5px; }
  }
</style>
