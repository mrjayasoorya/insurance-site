---
/**
 * ThinkingGapFiller.astro
 * "Still wondering?" — addresses the GAP between "I need insurance" and "I'll contact this agent".
 * These are NOT product FAQs — they're process/trust/fear-of-unknown questions.
 * Each item opens as an accordion with a direct WhatsApp CTA visible after the answer.
 * Props:
 *   title    – section heading
 *   subtitle – optional
 *   items    – array of { q, a }
 *   waNumber – WhatsApp number
 *   waText   – default WhatsApp message
 */
const {
  title = "Still wondering? Here's what most people ask before reaching out",
  subtitle = "",
  items = [],
  waNumber = "",
  waText = "Hi, I have a question about insurance. Can you guide me?",
} = Astro.props;
---

{items.length > 0 && (
  <section class="tgf section section-padding" aria-labelledby="tgf-title">
    <h2 id="tgf-title" class="section-title">{title}</h2>
    {subtitle && <p class="section-sub readable">{subtitle}</p>}

    <div class="tgf-list">
      {items.map((item, i) => (
        <details class="tgf-item" open={i < 2}>
          <summary class="tgf-q">
            <span class="tgf-icon">?</span>
            <span>{item.q}</span>
          </summary>
          <div class="tgf-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    {waNumber && (
      <div class="tgf-foot">
        <p class="tgf-foot-text">Have a different question? Just ask — no commitment needed.</p>
        <a
          class="tgf-wa"
          href={`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`}
          target="_blank"
          rel="noopener"
        >
          Ask on WhatsApp →
        </a>
      </div>
    )}
  </section>
)}

<style>
  .tgf-list{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-top:16px;
  }
  .tgf-item{
    border:1px solid var(--border);
    border-radius:14px;
    background:var(--surface);
    box-shadow:0 1px 6px rgba(11,13,18,.04);
    overflow:hidden;
  }
  .tgf-item[open]{
    border-color:#bbf7d0;
    background:#fafffe;
  }
  .tgf-q{
    display:flex;
    align-items:center;
    gap:10px;
    padding:14px 16px;
    cursor:pointer;
    font-size:14px;
    font-weight:800;
    line-height:1.35;
    list-style:none;
  }
  .tgf-q::-webkit-details-marker{ display:none; }
  .tgf-q::marker{ display:none; content:""; }
  .tgf-icon{
    flex:0 0 auto;
    width:24px;height:24px;
    border-radius:50%;
    background:#f0fdf4;
    color:#15803d;
    font-weight:900;
    font-size:12px;
    display:grid;
    place-items:center;
    border:1px solid #bbf7d0;
  }
  .tgf-a{
    padding:0 16px 14px 50px;
    font-size:13.5px;
    line-height:1.5;
    color:var(--text);
    opacity:.88;
  }
  .tgf-a p{ margin:0; }
  .tgf-foot{
    margin-top:18px;
    padding:14px 16px;
    border:1px solid #bbf7d0;
    border-radius:14px;
    background:#f0fdf4;
    display:flex;
    align-items:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .tgf-foot-text{
    margin:0;
    font-size:13.5px;
    font-weight:700;
    color:#15803d;
    flex:1;
    min-width:180px;
  }
  .tgf-wa{
    display:inline-flex;
    align-items:center;
    padding:8px 16px;
    border-radius:999px;
    background:#25d366;
    color:#fff;
    font-size:13px;
    font-weight:700;
    text-decoration:none;
    white-space:nowrap;
    transition:background .15s;
  }
  .tgf-wa:hover{ background:#1ebe57; }

  @media(max-width:820px){
    .tgf-q{ font-size:13px; padding:12px 14px; }
    .tgf-a{ font-size:13px; padding:0 14px 12px 44px; }
    .tgf-foot{ flex-direction:column; align-items:flex-start; gap:10px; }
  }
</style>
