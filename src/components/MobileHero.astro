---
const { brand, heroH1 } = Astro.props;

const telHref = brand?.phoneE164 ? `tel:${brand.phoneE164}` : `tel:${brand?.phone}`;
const waHref = brand?.whatsappE164
  ? `https://wa.me/${brand.whatsappE164}?text=${encodeURIComponent(brand?.whatsappPrefill || "Hi, I need insurance guidance. Please help.")}`
  : "#";
const phone = brand?.phone || "7448324068";
---

<div class="m-hero">
  <!-- Trust badge row -->
  <div class="mh-trust">
    <span class="mh-badge">
      <span class="mh-dot" aria-hidden="true"></span>
      30 Yrs Experience
    </span>
    <span class="mh-badge">4.9★ Google</span>
    <span class="mh-badge">Sholavaram</span>
    <span class="mh-badge">Free Guidance</span>
  </div>

  <h2 class="mh-name">{heroH1 || brand.name}</h2>

  {brand.tagline && (
    <p class="mh-tagline">{brand.tagline}</p>
  )}

  <p class="mh-sub">
    {brand.subtitle || "Commercial & personal insurance — lorry, fleet, factory, health & motor. Chennai North."}
  </p>

  <!-- Dual CTA stacked for mobile -->
  <div class="mh-cta-stack">
    <a class="mh-btn mh-wa" href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp for guidance">
      <svg class="mh-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      <span>WhatsApp for Guidance</span>
    </a>
    <a class="mh-btn mh-call" href={telHref} aria-label={`Call ${phone}`}>
      <svg class="mh-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" width="18" height="18">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.71 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.91.35 1.85.58 2.81.71A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>Call {phone}</span>
    </a>
  </div>
</div>

<style is:global>
  .m-hero {
    padding: 14px 10px 10px;
  }

  .mh-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }
  .mh-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: #f6f7f9;
    border: 1px solid #e7e9ee;
    font-size: 11px;
    font-weight: 700;
    color: #374151;
  }
  .mh-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
  }

  .mh-name {
    margin: 0 0 6px;
    font-size: 26px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #0b0d12;
  }

  .mh-tagline {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 700;
    color: #374151;
  }

  .mh-sub {
    margin: 0 0 16px;
    font-size: 13.5px;
    line-height: 1.5;
    color: #5b616e;
  }

  .mh-cta-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mh-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: transform 80ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .mh-btn:active { transform: scale(0.97); }

  .mh-wa {
    background: #22c55e;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(34,197,94,0.28);
  }

  .mh-call {
    background: #0b0f19;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(11,15,25,0.18);
  }

  .mh-ico { flex-shrink: 0; }
</style>
