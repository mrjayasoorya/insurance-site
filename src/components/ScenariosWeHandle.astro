---
/**
 * ScenariosWeHandle.astro
 * "Real situations we handle" — confidence builder showing specific real-world scenarios.
 * Each scenario shows: what happened → how we helped → WhatsApp CTA for similar case.
 * Props:
 *   title     – section heading (default: "Real situations we handle")
 *   subtitle  – optional subtitle
 *   scenarios – array of { title, situation, howWeHelped, waText }
 *   waNumber  – WhatsApp number (E164 without +)
 */
const {
  title = "Real situations we handle",
  titleMobile = "",
  subtitle = "",
  subtitleMobile = "",
  scenarios = [],
  waNumber = "",
} = Astro.props;
---

{scenarios.length > 0 && (
  <section class="swh section section-padding" aria-labelledby="swh-title">
    {titleMobile && titleMobile !== title ? (
      <h2 id="swh-title" class="section-title"><span class="ui-desktop">{title}</span><span class="ui-mobile">{titleMobile}</span></h2>
    ) : (
      <h2 id="swh-title" class="section-title">{title}</h2>
    )}
    {subtitle && subtitleMobile && subtitleMobile !== subtitle ? (
      <p class="section-sub readable"><span class="ui-desktop">{subtitle}</span><span class="ui-mobile">{subtitleMobile}</span></p>
    ) : (
      subtitle && <p class="section-sub readable">{subtitle}</p>
    )}

    <div class="swh-grid">
      {scenarios.map((s, i) => (
        <article class="swh-card">
          <div class={`swh-num swh-num--${i % 6}`}>{i + 1}</div>
          <h3 class="swh-heading">{s.title}</h3>
          <div class="swh-body">
            <p class="swh-label">The situation</p>
            <p class="swh-text">{s.situation}</p>
            <p class="swh-label">How we helped</p>
            <p class="swh-text">{s.howWeHelped}</p>
          </div>
          {waNumber && s.waText && (
            <a
              class="swh-cta"
              href={`https://wa.me/${waNumber}?text=${encodeURIComponent(s.waText)}`}
              target="_blank"
              rel="noopener"
              aria-label={`WhatsApp about ${s.title}`}
            >
              I have a similar situation →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
)}

<style is:inline>
  .swh-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:16px;
    margin-top:16px;
  }
  .swh-card{
    position:relative;
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px 18px 16px;
    background:var(--surface);
    box-shadow:0 2px 10px rgba(11,13,18,.05);
    display:flex;
    flex-direction:column;
  }
  .swh-num{
    width:28px;height:28px;
    border-radius:50%;
    font-weight:900;
    font-size:13px;
    display:grid;
    place-items:center;
    margin-bottom:10px;
  }
  .swh-num--0{ background:#e6faf6; color:#0d9488; }
  .swh-num--1{ background:#fff4e0; color:#b45309; }
  .swh-num--2{ background:#e8f1ff; color:#1d4ed8; }
  .swh-num--3{ background:#f4edff; color:#7c3aed; }
  .swh-num--4{ background:#ffeeee; color:#dc2626; }
  .swh-num--5{ background:#eafbe9; color:#15803d; }
  .swh-heading{
    font-size:15px;
    font-weight:950;
    margin:0 0 12px;
    line-height:1.3;
  }
  .swh-body{
    flex:1;
  }
  .swh-label{
    font-size:11px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.05em;
    color:var(--muted);
    margin:0 0 4px;
  }
  .swh-text{
    font-size:13.5px;
    line-height:1.45;
    margin:0 0 14px;
    color:var(--text);
    opacity:.9;
  }
  .swh-cta{
    display:inline-flex;
    align-items:center;
    padding:8px 14px;
    border-radius:999px;
    background:#25d366;
    color:#fff;
    font-size:12.5px;
    font-weight:700;
    text-decoration:none;
    margin-top:auto;
    width:fit-content;
    transition:background .15s;
  }
  .swh-cta:hover{ background:#1ebe57; }

  @media(max-width:820px){
    .swh-grid{
      grid-template-columns:1fr;
      gap:14px;
    }
    .swh-heading{ font-size:14px; }
    .swh-text{ font-size:13px; }
    .swh-cta{ font-size:12px; padding:7px 12px; }
  }
</style>
