---
/**
 * PageActionBar.astro
 * Inline dual-CTA block — placed immediately after H1+intro on inner pages.
 * NOT a floating/sticky element. Drives first-viewport conversion on service,
 * location and intent pages where users arrive with specific intent.
 *
 * Props:
 *   brand    — siteData.brand object (phoneE164, whatsappE164, whatsappPrefill, phone)
 *   context  — short context for WhatsApp pre-fill (e.g. "lorry insurance", "Red Hills")
 */
const { brand = {}, context = "" } = Astro.props;

const waText = context
  ? `Hi, I need help with ${context} insurance. Please guide me.`
  : (brand?.whatsappPrefill || "Hi, I need insurance guidance. Please help.");

const waHref = brand?.whatsappE164
  ? `https://wa.me/${brand.whatsappE164}?text=${encodeURIComponent(waText)}`
  : "#";
const telHref = brand?.phoneE164 ? `tel:${brand.phoneE164}` : "#";
const phone = brand?.phone || brand?.phoneE164 || "7448324068";
---

<div class="pab" role="group" aria-label="Quick contact">
  <a class="pab-wa" href={waHref} target="_blank" rel="noopener noreferrer">
    <svg class="pab-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
    <span>WhatsApp — free guidance</span>
  </a>

  <a class="pab-call" href={telHref}>
    <svg class="pab-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.71 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.91.35 1.85.58 2.81.71A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>Call {phone}</span>
  </a>

  <p class="pab-trust">30 yrs experience &middot; Licensed &middot; No commitment &middot; Sholavaram</p>
</div>

<style is:global>
  .pab {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 24px;
    padding: 16px 18px;
    background: #f6f8fc;
    border: 1px solid #e3e7ef;
    border-radius: 16px;
  }

  .pab-wa,
  .pab-call {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .pab-wa:hover, .pab-call:hover { opacity: 0.88; }

  .pab-wa {
    background: #22c55e;
    color: #fff;
  }

  .pab-call {
    background: #0b0f19;
    color: #fff;
  }

  .pab-ico {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .pab-trust {
    font-size: 12px;
    color: #6b7280;
    margin: 0;
    width: 100%;
  }

  @media (max-width: 480px) {
    .pab-wa, .pab-call { width: 100%; justify-content: center; }
  }
</style>
