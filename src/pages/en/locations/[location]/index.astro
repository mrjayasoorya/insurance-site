---
// src/pages/en/locations/[location]/index.astro
// RESTRUCTURED: Services moved up, low-value sections trimmed

import DesktopHero from "../../../../components/DesktopHero.astro";
import MobileHero from "../../../../components/MobileHero.astro";
import MobileAccordion from "../../../../components/MobileAccordion.astro";
import FooterCtaBar from "../../../../components/FooterCtaBar.astro";
import GlobalOverlays from "src/components/GlobalOverlays.astro";
import BacklinksRow from "../../../../components/BacklinksRow.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";

import { siteData, EN } from "../../../../content/siteData";
import { buildMeta, buildJsonLd, canonicalFromPath, geoMetaFromBrand } from "../../../../lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";
import UserQuestionsBlock from "src/components/UserQuestionsBlock.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";

export async function getStaticPaths() {
  const all = siteData.locationsDetail || {};
  return Object.keys(all).map((location) => ({ params: { location } }));
}

const { location } = Astro.params;
const data = siteData.locationsDetail?.[location];
if (!data) throw new Error(`Unknown location: ${location}`);

// Confidence content
const cc = siteData.confidenceContent || {};
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");

const canonical = canonicalFromPath(siteData.brand.websiteUrl, `/en/locations/${location}/`);

const meta = buildMeta({
  title: `${data.seoTitle} | ${siteData.brand.shortName}`,
  description: data.seoDesc,
  canonical,
  ogType: "website",
  geo: geoMetaFromBrand(siteData),
});

// Intent router
const intentCards = data.intentCards?.length
  ? data.intentCards
  : [
      { title: "Insurance near me", desc: "How local support works, documents to share first.", href: EN("/insurance-near-me/") },
      { title: "Insurance renewal help", desc: "Renewal checks: IDV/NCB/add-ons, permits/fitness.", href: EN("/insurance-renewal-near-me/") },
      { title: "Insurance claim help", desc: "First steps, proof that matters, incident timeline.", href: EN("/insurance-claim-help/") },
      { title: "All services", desc: "Transport, industrial, contractor, MSME and claim support.", href: EN("/services/") },
    ];

// Service cards
const serviceCards = (data.serviceCards?.length ? data.serviceCards : (data.serviceLinks || []).map((s) => ({
  title: s.title,
  href: s.href,
  desc: s.desc || "Coverage details, documents and claim guidance.",
})));

// Nearby areas
const nearbyItems = data.nearbyAreas?.items?.length
  ? data.nearbyAreas.items
  : (data.relatedLocations || []).map((x) => ({ ...x, desc: x.desc || "Open nearby area guide." }));

const jsonLd = buildJsonLd({
  pageType: "locationDetail",
  siteData,
  canonical,
  title: meta.title,
  description: meta.description,
  locationName: data.name,
  locationPostalCode: data.postalCode,
  breadcrumbs: [
    { name: "Home", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/") },
    { name: "Locations", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/locations/") },
    { name: data.name, href: canonical },
  ],
  faqs: (data.faqs || []),
});
---

<html lang="en">
  <head>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="stylesheet" href="/styles/theme.css" />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
  </head>

  <body>
    <main class="app">
      <div class="container">
        <!-- SINGLE DOM: hero variants switch at 820px (existing .ui-desktop/.ui-mobile breakpoint);
             all content below renders once. Mobile differences reproduced via CSS at 820px. -->
        <div class="ui-desktop">
          <header>
            <DesktopHero
              heroH1={data.heroH1}
              brand={{
                name: siteData.brand.name,
                tagline: siteData.brand.tagline,
                subtitle: data.heroP,
                phone: siteData.brand.phone,
                areaChips: siteData.brand.areaChips,
              }}
            />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: "Locations", href: EN("/locations/") },
            { label: data.heroH1 || data.name },
          ]} />
        </div>

        <div class="ui-mobile">
          <header>
            <MobileHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: data.heroP,
              phone: siteData.brand.phone,
              areaChips: [],
            }} />
          </header>

          <!-- MobileHero uses <h2>; this gives the page a real <h1> below 820px (as before) -->
          <h1 class="sr-only">{data.heroH1}</h1>
        </div>

        {data.postalCode ? (
          <p class="readable loc-pin" style="opacity:.75;font-size:14px;margin:4px 0 0">
            {data.name} — Pin code {data.postalCode}
          </p>
        ) : null}

        <!-- 2. Services available here (PRIMARY user intent) -->
        {serviceCards?.length ? (
          <section class="section section-padding" aria-label="Services supported">
            <h2 class="section-title"><span class="ui-desktop">Services available in {data.name}</span><span class="ui-mobile">Services in {data.name}</span></h2>
            <p class="section-sub readable ui-desktop">
              Beyond the obvious cover, these are the risks people in {data.name} commonly ask about once we start talking—worth a look even if you called about something else.
            </p>
            <p class="section-sub readable ui-mobile">
              Worth a look even if you called about something else—these are the risks people here commonly ask about once we start talking.
            </p>
            <div class="grid grid-2">
              {serviceCards.map((s, i) => (
                <a class={`card lg-card lg-card--${i % 4}`} href={s.href}>
                  <h3 class="card-title">{s.title}</h3>
                  <p class="card-desc readable">{s.desc}</p>
                </a>
              ))}
            </div>
          </section>
        ) : null}

        <!-- 3. How support works from here -->
        {data.anchorAndCoordination?.title ? (
          <section class="section section-padding" aria-label="How support works">
            <h2 class="section-title">{data.anchorAndCoordination.title}</h2>
            {data.anchorAndCoordination.intro ? (
              <p class="section-sub readable">{data.anchorAndCoordination.intro}</p>
            ) : null}
            {data.anchorAndCoordination.bullets?.length ? (
              <ul class="bullets">{data.anchorAndCoordination.bullets.map((x) => <li>{x}</li>)}</ul>
            ) : null}
          </section>
        ) : null}

        <!-- 4. Common requests (desktop-only, as before) -->
        {data.commonRequests?.items?.length ? (
          <div class="ui-desktop">
            <section class="section section-padding" aria-label="Common requests">
              <h2 class="section-title">{data.commonRequests.title || `Common requests from ${data.name}`}</h2>
              <ul class="bullets">{data.commonRequests.items.map((x) => <li>{x}</li>)}</ul>
            </section>
          </div>
        ) : null}

        <!-- 4b. Who you are — persona-specific guidance -->
        {data.personaGuide?.length ? (
          <section class="section section-padding" aria-label="Guidance by situation">
            <h2 class="section-title">{data.personaGuideTitle || "Find your situation"}</h2>
            <div class="persona-grid">
              {data.personaGuide.map((p) => (
                <div class="persona-card">
                  <h3 class="persona-heading">{p.label}</h3>
                  {p.forWhom ? <p class="persona-sub readable">{p.forWhom}</p> : null}
                  <ul class="bullets">{p.points.map((pt) => <li>{pt}</li>)}</ul>
                  {p.waText && waNumber ? (
                    <a class="persona-cta" href={`https://wa.me/${waNumber}?text=${encodeURIComponent(p.waText)}`} target="_blank" rel="noopener">
                      {p.ctaLabel || "WhatsApp about this"}
                    </a>
                  ) : null}
                </div>
              ))}
            </div>
          </section>
        ) : null}

        <!-- 4c. Comparison table (scroll wrapper always present; min-width below 820px only) -->
        {data.comparisonTable?.rows?.length ? (
          <section class="section section-padding" aria-label="Comparison">
            <h2 class="section-title">{data.comparisonTable.title || "How this compares"}</h2>
            {data.comparisonTable.intro ? <p class="readable">{data.comparisonTable.intro}</p> : null}
            <div class="compare-scroll" style="overflow-x:auto">
              <table class="compare-table">
                <thead>
                  <tr class="compare-header">
                    {data.comparisonTable.columns.map((c, i) => (
                      <th class={`compare-cell ${i === 0 ? "compare-k" : ""} ${i === data.comparisonTable.columns.length - 1 ? "compare-us" : ""}`} scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {data.comparisonTable.rows.map((r) => (
                    <tr class="compare-row">
                      {r.map((cell, i) => (
                        i === 0
                          ? <th class="compare-cell compare-k" scope="row">{cell}</th>
                          : <td class={`compare-cell ${i === r.length - 1 ? "compare-us" : ""}`}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ) : null}

        <!-- SCENARIOS WE HANDLE: 3 in DOM; 3rd + subtitle hidden below 820px (was mobile slice(0,2)) -->
        <ScenariosWeHandle
          title={`Real situations we handle in ${data.name}`}
          titleMobile="Real situations we handle"
          subtitle="People from this area reach us with exactly these kinds of situations."
          scenarios={(data.scenarios?.length ? data.scenarios : (cc.homeScenarios || [])).slice(0, 3)}
          waNumber={waNumber}
        />

        <!-- STILL WONDERING: 4 in DOM; 4th hidden below 820px (was mobile slice(0,3)) -->
        <ThinkingGapFiller
          title="Still wondering?"
          items={(cc.homeGapQuestions || []).slice(0, 4)}
          waNumber={waNumber}
          waText={`Hi, I'm from ${data.name} area and need insurance guidance. Can you help?`}
        />

        <!-- USER QUESTIONS (mobile-only, as before) -->
        <div class="ui-mobile">
          <UserQuestionsBlock
            title="Common questions before you contact us"
            items={cc.userQuestions || []}
          />
        </div>

        <!-- WHY CHOOSE US -->
        <WhyChooseUs
          title="Why work with us"
          points={(cc.whyUs || []).slice(0, 4)}
        />

        <!-- MID-PAGE CTA — after trust content -->
        <ConversionBlock siteData={siteData} block={siteData.conversionBlocks.default} brand={siteData.brand} />

        <!-- SMART ASSIST — location page capture -->
        <SmartAssistForm
          brand={siteData.brand}
          id="sa-desk"
          heading="Need insurance support here? Send a quick message"
          subheading="Pick your situation — we pre-fill the WhatsApp message, you just send."
        />

        <!-- 5. Next steps (desktop-only, as before) -->
        {data.nextSteps?.bullets?.length ? (
          <div class="ui-desktop">
            <section class="section section-padding" aria-label="Next steps">
              <h2 class="section-title">{data.nextSteps.title || "What to do next"}</h2>
              <ul class="bullets">{data.nextSteps.bullets.map((x) => <li>{x}</li>)}</ul>
            </section>
          </div>
        ) : null}

        <!-- 6. FAQs (desktop h2 hidden on mobile; accordion group label unified to "FAQs") -->
        {data.faqs?.length ? (
          <section class="section section-padding" aria-label="FAQs">
            <div class="ui-desktop">
              <h2 class="section-title">FAQs for {data.name}</h2>
            </div>
            <MobileAccordion
              sections={[{
                title: "FAQs",
                items: data.faqs.map((f) => ({ strong: f.q, text: f.a })),
              }]}
              defaultOpen={true}
            />
          </section>
        ) : null}

        <!-- 7. Quick actions (desktop-only, as before) -->
        <div class="ui-desktop">
          <section class="section section-padding" aria-label="Quick actions">
            <h2 class="section-title">Quick actions</h2>
            <div class="grid grid-2">
              {intentCards.map((c, i) => (
                <a class={`card lg-card lg-card--${i % 4}`} href={c.href}>
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-desc readable">{c.desc}</p>
                </a>
              ))}
            </div>
          </section>
        </div>

        <!-- 8. Nearby areas -->
        {nearbyItems?.length ? (
          <section class="section section-padding" aria-label="Nearby areas">
            {data.nearbyAreas?.title ? (
              <h2 class="section-title">{data.nearbyAreas.title}</h2>
            ) : (
              <h2 class="section-title"><span class="ui-desktop">Nearby areas we also support</span><span class="ui-mobile">Nearby areas</span></h2>
            )}
            <ul class="link-rows" role="list">
              {nearbyItems.map((x) => (
                <li class="link-row">
                  <a class="rowlink" href={x.href}>
                    <span class="rowtitle">{x.label}</span>
                    <span class="rowdesc">{x.desc || "Open local context"}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

        <FooterCtaBar
          title={siteData.footerCtas.title}
          subtitle={siteData.footerCtas.subtitle}
          whatsappNumber={siteData.brand.whatsappE164}
          whatsappText={siteData.brand.whatsappPrefill}
          callNumber={siteData.brand.phoneE164}
          callLabel={siteData.footerCtas.callLabel}
          brandName={siteData.footerCtas.brandName}
          logoText={siteData.footerCtas.logoText}
          copyright={siteData.footerCtas.copyright}
        />

      </div>
    </main>

    <GlobalOverlays />

    <style is:global>
      .readable{ max-width: 78ch; }
      .grid{ display:grid; gap:12px; }
      .grid-2{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-1{ grid-template-columns: 1fr; }
      .card{
        display:block; padding:14px;
        border:1px solid var(--border); border-radius:16px;
        background: var(--surface); text-decoration:none;
        box-shadow: 0 2px 10px rgba(11,13,18,.05);
      }
      .card-title{ font-size:15px; margin:0; font-weight:950; letter-spacing:-0.01em; }
      .card-desc{ margin:8px 0 0; color: var(--muted); font-size:13px; line-height:1.35; }
      .glance{
        border:1px solid var(--border); background: var(--surface);
        border-radius: 16px; padding: 10px 12px;
        display:flex; flex-direction:column; gap:10px;
        box-shadow: 0 2px 10px rgba(11,13,18,.05);
      }
      .glance-row{ display:grid; grid-template-columns: 160px 1fr; gap: 10px; align-items:start; }
      .glance-k{ font-weight:950; opacity:.85; font-size:13px; }
      .glance-v{ opacity:.9; font-size:13.5px; line-height:1.35; }
      @media (max-width: 520px){ .glance-row{ grid-template-columns: 1fr; } }
      .link-rows{
        list-style:none; padding:0; margin: 12px 0 0;
        display:flex; flex-direction:column; gap: 10px;
      }
      .link-row{
        border:1px solid var(--border); background: var(--surface);
        border-radius: 16px; padding: 10px 12px;
        box-shadow: 0 2px 10px rgba(11,13,18,.05);
      }
      .rowlink{ display:flex; flex-direction:column; gap:6px; text-decoration:none; }
      .rowtitle{ font-weight: 950; }
      .rowdesc{ color: var(--muted); font-size: 13px; line-height: 1.35; }
      @media (max-width: 980px){ .grid-2{ grid-template-columns: 1fr; } }

      .persona-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-top:16px}
      .persona-card{border:1px solid var(--border);border-radius:16px;background:var(--surface);padding:16px;display:flex;flex-direction:column;gap:8px}
      .persona-heading{margin:0;font-size:16px;font-weight:950;letter-spacing:-0.01em}
      .persona-sub{margin:0;font-size:13px;opacity:.8}
      .persona-cta{margin-top:auto;display:inline-block;padding:9px 14px;border-radius:10px;background:#25D366;color:#0b0d12;font-weight:800;font-size:13px;text-decoration:none;text-align:center}
      .compare-table{width:100%;border:1px solid var(--border);border-radius:12px;overflow:hidden;border-collapse:collapse}
      .compare-header, .compare-row{display:table-row}
      .compare-header{background:var(--surface);font-weight:900;font-size:13px}
      .compare-row{border-top:1px solid var(--border)}
      .compare-cell{display:table-cell;padding:10px 12px;font-size:13px;line-height:1.35;text-align:left;font-weight:400}
      .compare-k{font-weight:700;opacity:.85}
      .compare-us{background:rgba(46,125,50,.06);font-weight:600}
      @media (max-width:520px){.compare-header{font-size:11px}.compare-cell{padding:8px 6px}}

      /* Single-DOM merge: reproduce previous mobile tree at the existing 820px switch */
      @media (min-width: 821px){
        .compare-scroll{margin-top:16px}
      }
      @media (max-width: 820px){
        .loc-pin{padding:0 16px}
        .swh > .section-sub{display:none}
        .swh-grid > .swh-card:nth-child(3){display:none}
        .tgf-list > .tgf-item:nth-child(4){display:none}
        .compare-scroll .compare-table{min-width:480px;margin-top:16px}
      }
    </style>
  </body>
</html>
