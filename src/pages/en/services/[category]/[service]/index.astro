---
// src/pages/en/services/[category]/[service]/index.astro
// RESTRUCTURED: Section order based on user search intent + conversion data

import DesktopHero from "../../../../../components/DesktopHero.astro";
import MobileHero from "../../../../../components/MobileHero.astro";
import MobileAccordion from "../../../../../components/MobileAccordion.astro";
import FooterCtaBar from "../../../../../components/FooterCtaBar.astro";
import GlobalOverlays from "src/components/GlobalOverlays.astro";
import BacklinksRow from "src/components/BacklinksRow.astro";
import ServiceLocalSupport from "src/components/ServiceLocalSupport.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import Breadcrumbs from "src/components/Breadcrumbs.astro";

import { siteData, EN, SERVICE_LOCAL_SUPPORT } from "../../../../../content/siteData";
import { buildMeta, buildJsonLd, canonicalFromPath } from "../../../../../lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";

export async function getStaticPaths() {
  const all = siteData?.servicesDetail || {};
  const paths = [];
  for (const category of Object.keys(all)) {
    const services = all[category] || {};
    for (const service of Object.keys(services)) {
      paths.push({ params: { category, service } });
    }
  }
  return paths;
}

const { category, service: serviceSlug } = Astro.params;
const data = siteData?.servicesDetail?.[category]?.[serviceSlug];
if (!data) throw new Error(`Unknown service: ${category}/${serviceSlug}`);

const canonical = canonicalFromPath(siteData.brand.websiteUrl, `/en/services/${category}/${serviceSlug}/`);

const meta = buildMeta({
  title: `${data.seoTitle} | ${siteData.brand.name}`,
  description: data.seoDesc,
  canonical,
  ogType: "article",
});

const jsonLd = buildJsonLd({
  pageType: "serviceDetail",
  siteData,
  canonical,
  title: meta.title,
  description: meta.description,
  serviceData: data,
  breadcrumbs: [
    { name: "Home", href: "/en/" },
    { name: "Services", href: "/en/services/" },
    { name: category, href: `/en/services/${category}/` },
    { name: data.heroH1, href: canonical },
  ],
  faqs: data.faqs || [],
});

const localSupportSlugs = SERVICE_LOCAL_SUPPORT?.[category]?.[serviceSlug] || [];

const atAGlance = [
  { k: "Best for", v: (data.whoFor || []).slice(0, 2).join(" · ") },
  { k: "Key coverage", v: (data.keyCoverFocus || []).slice(0, 2).join(" · ") },
  { k: "Watch out for", v: (data.whatCanGoWrong || []).slice(0, 1).join("") },
  { k: "Documents", v: (data.claimDocs || []).slice(0, 2).join(" · ") },
].filter((x) => x.v);

const linkCards = (data.internalLinks || []).map((l) => ({
  ...l,
  desc: l.desc || "Coverage details, documents and claim guidance.",
}));

const intentCards = [
  { title: "Insurance near me", desc: "How local support works, document checklist, insurer inspections.", href: EN("/insurance-near-me/") },
  { title: "Insurance renewal help", desc: "Renewal checks: IDV/NCB/add-ons, permits/fitness as applicable.", href: EN("/insurance-renewal-near-me/") },
  { title: "Insurance claim help", desc: "First steps, proof that matters, incident timeline guidance.", href: EN("/insurance-claim-help/") },
];

// Confidence content — scenarios and gap-fillers specific to this service
const cc = siteData.confidenceContent || {};
const svcScenarios = cc.serviceScenarios?.[category]?.[serviceSlug] || cc.homeScenarios?.slice(0, 2) || [];
const svcGapQs = cc.serviceGapQuestions?.[category] || cc.homeGapQuestions?.slice(0, 3) || [];
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");
---

<html lang="en">
  <head>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="stylesheet" href="/styles/theme.css" />
  </head>

  <body>
    <main class="app">
      <div class="container">

        <!-- ========================= DESKTOP ========================= -->
        <div class="ui-desktop">
          <header>
            <DesktopHero
              brand={{
                name: siteData.brand.name,
                tagline: siteData.brand.tagline,
                subtitle: data.heroP,
                phone: siteData.brand.phone,
                phoneE164: siteData.brand.phoneE164,
                whatsappE164: siteData.brand.whatsappE164,
                whatsappPrefill: `Hi, I need help with ${data.heroH1}. Please guide me.`,
                areaChips: siteData.brand.areaChips,
              }}
            />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: "Services", href: EN("/services/") },
            { label: category.replace(/-/g, " "), href: EN(`/services/${category}/`) },
            { label: data.heroH1 },
          ]} />

          <!-- 1. H1 + CTA (immediate action) -->
          <section class="section section-padding" aria-label="Service overview">
            <h1 class="section-title">{data.heroH1}</h1>
            <p class="section-sub readable">{data.heroP}</p>
            <PageActionBar brand={siteData.brand} context={data.heroH1 || ""} />
          </section>

          <!-- 2. At a glance (quick facts) -->
          {atAGlance.length ? (
            <section class="section section-padding" aria-label="At a glance">
              <h2 class="section-title">At a glance</h2>
              <div class="glance">
                {atAGlance.map((x) => (
                  <div class="glance-row">
                    <div class="glance-k">{x.k}</div>
                    <div class="glance-v">{x.v}</div>
                  </div>
                ))}
              </div>
            </section>
          ) : null}

          <!-- 3. What this covers (PRIMARY user search intent) -->
          {data.keyCoverFocus?.length ? (
            <section class="section section-padding" aria-label="What this covers">
              <h2 class="section-title">What this covers</h2>
              <ul class="bullets">{data.keyCoverFocus.map((x) => <li>{x}</li>)}</ul>
              {data.standardModules?.bullets?.length ? (
                <details class="expand-block" style="margin-top:14px">
                  <summary class="expand-trigger">{data.standardModules.title || "Coverage modules & add-ons"}</summary>
                  <ul class="bullets" style="margin-top:10px">{data.standardModules.bullets.map((x) => <li>{x}</li>)}</ul>
                </details>
              ) : null}
            </section>
          ) : null}

          <!-- 4. Who this is for (user identification) -->
          {data.whoFor?.length ? (
            <section class="section section-padding" aria-label="Who this is for">
              <h2 class="section-title">Who this is for</h2>
              <ul class="bullets">{data.whoFor.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- 5. Documents you'll need (actionable) -->
          {data.claimDocs?.length ? (
            <section class="section section-padding" aria-label="Documents checklist">
              <h2 class="section-title">Documents you'll need</h2>
              <ul class="bullets">{data.claimDocs.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- 6. What affects pricing (high search demand) -->
          {data.pricingFactors?.bullets?.length ? (
            <section class="section section-padding" aria-label="Pricing factors">
              <h2 class="section-title">{data.pricingFactors.title || "What affects your premium"}</h2>
              <ul class="bullets">{data.pricingFactors.bullets.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- SCENARIOS WE HANDLE — service-specific confidence -->
          <ScenariosWeHandle
            title={`Real situations we've handled — ${data.heroH1.split('(')[0].trim()}`}
            subtitle="If your situation is similar, we can help. Send a WhatsApp message to get started."
            scenarios={svcScenarios}
            waNumber={waNumber}
          />

          <!-- MID-PAGE CTA (user has core info → capture now) -->
          <ConversionBlock siteData={siteData} block={siteData.conversionBlocks.default} brand={siteData.brand} />

          <!-- 8. Mistakes to avoid (trust-building) -->
          {(data.commonMistakes?.length || data.whatCanGoWrong?.length) ? (
            <section class="section section-padding" aria-label="Mistakes to avoid">
              <h2 class="section-title">Mistakes that delay or reduce claims</h2>
              <ul class="bullets">
                {(data.commonMistakes || []).map((x) => <li>{x}</li>)}
                {(data.whatCanGoWrong || []).map((x) => <li>{x}</li>)}
              </ul>
            </section>
          ) : null}

          <!-- 9. Before you buy / renew -->
          {data.preBuyChecklist?.bullets?.length ? (
            <section class="section section-padding" aria-label="Before you buy or renew">
              <h2 class="section-title">{data.preBuyChecklist.title || "Before you buy or renew"}</h2>
              <ul class="bullets">{data.preBuyChecklist.bullets.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- GAP-FILLER — what users wonder before contacting -->
          <ThinkingGapFiller
            title="Still wondering?"
            subtitle="Common questions people have before reaching out about this type of insurance."
            items={svcGapQs}
            waNumber={waNumber}
            waText={`Hi, I have a question about ${data.heroH1.split('(')[0].trim()}. Can you guide me?`}
          />

          <!-- SMART ASSIST — service detail capture -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-desk"
            heading="Have a question about this service? Pre-fill your WhatsApp"
            subheading="Pick your situation — we build the message, you just send."
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us for this"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <!-- 10. FAQs (catches remaining questions) -->
          {data.faqs?.length ? (
            <section class="section section-padding" aria-label="FAQs">
              <h2 class="section-title">Frequently asked questions</h2>
              <MobileAccordion
                sections={[{
                  title: "Questions people ask",
                  items: data.faqs.map((f) => ({ strong: f.q, text: f.a })),
                }]}
                defaultOpen={true}
              />
            </section>
          ) : null}

          <!-- FINAL CTA -->
          <ConversionBlock siteData={siteData} block={siteData.conversionBlocks.default} brand={siteData.brand} />

          <!-- 11. Related services -->
          {linkCards.length ? (
            <section class="section section-padding" aria-label="Related services">
              <h2 class="section-title">Related services</h2>
              <div class="grid grid-2">
                {linkCards.map((l) => (
                  <a class="card" href={l.href}>
                    <h3 class="card-title">{l.label}</h3>
                    <p class="card-desc readable">{l.desc}</p>
                  </a>
                ))}
              </div>
            </section>
          ) : null}

          <!-- 12. Quick actions -->
          <section class="section section-padding" aria-label="Quick actions">
            <h2 class="section-title">Quick actions</h2>
            <div class="grid grid-2">
              {intentCards.map((c) => (
                <a class="card" href={c.href}>
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-desc readable">{c.desc}</p>
                </a>
              ))}
            </div>
          </section>

          <!-- 13. Local support (internal links to service areas) -->
          <ServiceLocalSupport
            title={`Local support for ${data.heroH1 || "this service"}`}
            subtitle="Support is coordinated from Sholavaram. Location pages provide area-specific context."
            slugs={localSupportSlugs}
            max={10}
          />

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>

        <!-- ========================= MOBILE ========================= -->
        <div class="ui-mobile">
          <header>
            <MobileHero
              brand={{
                name: siteData.brand.name,
                tagline: siteData.brand.tagline,
                subtitle: data.heroP,
                phone: siteData.brand.phone,
                phoneE164: siteData.brand.phoneE164,
                whatsappE164: siteData.brand.whatsappE164,
                whatsappPrefill: `Hi, I need help with ${data.heroH1}. Please guide me.`,
                areaChips: [],
              }}
            />
          </header>

          <!-- 1. H1 + CTA -->
          <section class="section section-padding">
            <h1 class="section-title">{data.heroH1}</h1>
            <p class="section-sub readable">{data.heroP}</p>
            <PageActionBar brand={siteData.brand} context={data.heroH1 || ""} />
          </section>

          <!-- 2. At a glance -->
          {atAGlance.length ? (
            <section class="section section-padding">
              <h2 class="section-title">At a glance</h2>
              <div class="glance">
                {atAGlance.map((x) => (
                  <div class="glance-row">
                    <div class="glance-k">{x.k}</div>
                    <div class="glance-v">{x.v}</div>
                  </div>
                ))}
              </div>
            </section>
          ) : null}

          <!-- 3. What this covers -->
          {data.keyCoverFocus?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">What this covers</h2>
              <ul class="bullets">{data.keyCoverFocus.map((x) => <li>{x}</li>)}</ul>
              {data.standardModules?.bullets?.length ? (
                <details class="expand-block" style="margin-top:14px">
                  <summary class="expand-trigger">{data.standardModules.title || "Coverage modules & add-ons"}</summary>
                  <ul class="bullets" style="margin-top:10px">{data.standardModules.bullets.map((x) => <li>{x}</li>)}</ul>
                </details>
              ) : null}
            </section>
          ) : null}

          <!-- 4. Who this is for -->
          {data.whoFor?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Who this is for</h2>
              <ul class="bullets">{data.whoFor.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- 5. Documents -->
          {data.claimDocs?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Documents you'll need</h2>
              <ul class="bullets">{data.claimDocs.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- 6. Pricing -->
          {data.pricingFactors?.bullets?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">{data.pricingFactors.title || "What affects your premium"}</h2>
              <ul class="bullets">{data.pricingFactors.bullets.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- SCENARIOS WE HANDLE (mobile) -->
          <ScenariosWeHandle
            title="Real situations we've handled"
            scenarios={svcScenarios.slice(0, 2)}
            waNumber={waNumber}
          />

          <!-- MID-PAGE CTA -->
          <ConversionBlock siteData={siteData} block={siteData.conversionBlocks.default} brand={siteData.brand} />

          <!-- 8. Mistakes to avoid -->
          {(data.commonMistakes?.length || data.whatCanGoWrong?.length) ? (
            <section class="section section-padding">
              <h2 class="section-title">Mistakes that delay or reduce claims</h2>
              <ul class="bullets">
                {(data.commonMistakes || []).map((x) => <li>{x}</li>)}
                {(data.whatCanGoWrong || []).map((x) => <li>{x}</li>)}
              </ul>
            </section>
          ) : null}

          <!-- GAP-FILLER (mobile) -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={svcGapQs.slice(0, 3)}
            waNumber={waNumber}
            waText={`Hi, I have a question about ${data.heroH1.split('(')[0].trim()}. Can you guide me?`}
          />

          <!-- SMART ASSIST — service detail capture (mobile) -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-mob"
            heading="Have a question about this service? Pre-fill your WhatsApp"
            subheading="Pick your situation — we build the message, you just send."
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us for this"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <!-- 9. FAQs -->
          {data.faqs?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Frequently asked questions</h2>
              <MobileAccordion sections={[{ title: "Questions people ask", items: data.faqs.map((f) => ({ strong: f.q, text: f.a })) }]} defaultOpen={true} />
            </section>
          ) : null}

          <!-- FINAL CTA -->
          <ConversionBlock siteData={siteData} block={siteData.conversionBlocks.default} brand={siteData.brand} />

          <!-- 10. Related services -->
          {linkCards.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Related services</h2>
              <div class="grid grid-1">
                {linkCards.map((l) => (
                  <a class="card" href={l.href}>
                    <h3 class="card-title">{l.label}</h3>
                    <p class="card-desc readable">{l.desc}</p>
                  </a>
                ))}
              </div>
            </section>
          ) : null}

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>

      </div>
    </main>

    <GlobalOverlays />

    <style>
      .readable { max-width: 78ch; }

      .glance{
        border:1px solid var(--border);
        background: var(--surface);
        border-radius: 16px;
        padding: 10px 12px;
        display:flex;
        flex-direction:column;
        gap:10px;
        box-shadow: 0 2px 10px rgba(11,13,18,.05);
      }
      .glance-row{
        display:grid;
        grid-template-columns: 160px 1fr;
        gap: 10px;
        align-items:start;
      }
      .glance-k{
        font-weight: 950;
        opacity: .85;
        font-size: 13px;
      }
      .glance-v{
        opacity: .9;
        font-size: 13.5px;
        line-height: 1.35;
      }
      .expand-block{
        border:1px solid var(--border);
        border-radius:12px;
        padding:10px 14px;
      }
      .expand-trigger{
        cursor:pointer;
        font-weight:900;
        font-size:14px;
      }

      @media (max-width: 520px){
        .glance-row{ grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
