---
// src/pages/en/services/[category]/index.astro
// RESTRUCTURED: Added Breadcrumbs, PageActionBar, howWeWork, tightened sections

import DesktopHero from "../../../../components/DesktopHero.astro";
import MobileHero from "../../../../components/MobileHero.astro";
import FooterCtaBar from "../../../../components/FooterCtaBar.astro";
import GlobalOverlays from "../../../../components/GlobalOverlays.astro";
import BacklinksRow from "../../../../components/BacklinksRow.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { siteData, EN } from "../../../../content/siteData";
import { buildJsonLd, buildMeta, canonicalFromPath, geoMetaFromBrand } from "../../../../lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";
import UserQuestionsBlock from "src/components/UserQuestionsBlock.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";

export async function getStaticPaths() {
  return (siteData.serviceCategories || []).map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = (siteData.serviceCategories || []).find((x) => x.slug === category);
if (!cat) throw new Error(`Unknown category: ${category}`);

// Rotate each child link through a small tint palette by position — a light
// touch of color so the grid isn't uniform gray, without needing a full
// per-category color lookup across ~25 category slugs (incl. alias pages).
const tintFor = (i) => `lg-card lg-card--${i % 4}`;

// Confidence content
const cc = siteData.confidenceContent || {};
const catScenarios = cc.serviceScenarios?.[category] ? Object.values(cc.serviceScenarios[category]).flat().slice(0, 3) : (cc.homeScenarios || []).slice(0, 2);
const catGapQs = cc.serviceGapQuestions?.[category] || (cc.homeGapQuestions || []).slice(0, 3);
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");

const canonical = canonicalFromPath(siteData.brand.websiteUrl, `/en/services/${category}/`);

const meta = buildMeta({
  title: `${cat.title} | Services | ${siteData.brand.shortName}`,
  description: cat.desc,
  canonical,
  ogType: "website",
  geo: geoMetaFromBrand(siteData),
});

const jsonLd = buildJsonLd({
  pageType: "serviceCategory",
  siteData,
  canonical,
  title: meta.title,
  description: meta.description,
  breadcrumbs: [
    { name: "Home", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/") },
    { name: "Services", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/services/") },
    { name: cat.title, href: canonical },
  ]
});
---

<html lang="en">
  <head>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/styles/theme.css" />
  </head>

  <body>
    <main class="app">
      <div class="container">

        <!-- ========================= DESKTOP ========================= -->
        <div class="ui-desktop">
          <header>
            <DesktopHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: cat.desc,
              phone: siteData.brand.phone,
              areaChips: siteData.brand.areaChips,
            }} />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: "Services", href: EN("/services/") },
            { label: cat.title },
          ]} />

          <!-- 1. H1 + CTA -->
          <section class="section section-padding">
            <h1 class="section-title">{cat.title}</h1>
            <p class="section-sub readable">{cat.desc}</p>
            <PageActionBar brand={siteData.brand} context={cat.title} />
          </section>

          <!-- 2. Services in this category (PRIMARY intent) -->
          <section class="section section-padding" aria-label="Services in this category">
            <h2 class="section-title">Services under {cat.title}</h2>
            <div class="grid grid-2">
              {cat.children?.map((x, i) => (
                <a class={`card ${tintFor(i)}`} href={x.href}>
                  <h3 class="card-title">{x.title}</h3>
                  <p class="card-desc">Coverage, documents & claim guidance</p>
                </a>
              ))}
            </div>
          </section>

          <!-- 3. Common problems -->
          {cat.problems?.length ? (
            <section class="section section-padding" aria-label="Common problems">
              <h2 class="section-title">Common problems in this category</h2>
              <ul class="bullets">{cat.problems.map((p) => <li>{p}</li>)}</ul>
            </section>
          ) : null}

          <!-- USER QUESTIONS -->
          <UserQuestionsBlock
            title="Common questions before you contact us"
            items={cc.userQuestions || []}
          />

          <!-- SMART ASSIST — service category capture -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-desk"
            heading="Have a question about this? Send us a message"
            subheading="Pick your situation — we pre-fill the WhatsApp message, you just send."
          />

          <!-- SCENARIOS WE HANDLE -->
          <ScenariosWeHandle
            title="Real situations we handle"
            scenarios={catScenarios.slice(0, 3)}
            waNumber={waNumber}
          />

          <!-- STILL WONDERING -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={catGapQs.slice(0, 4)}
            waNumber={waNumber}
            waText={`Hi, I have a question about ${cat.title}. Can you guide me?`}
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>

        <!-- ========================= MOBILE ========================= -->
        <div class="ui-mobile">
          <header>
            <MobileHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: cat.desc,
              phone: siteData.brand.phone,
              areaChips: [],
            }} />
          </header>

          <!-- 1. H1 + CTA -->
          <section class="section section-padding">
            <h1 class="section-title">{cat.title}</h1>
            <p class="section-sub readable">{cat.desc}</p>
            <PageActionBar brand={siteData.brand} context={cat.title} />
          </section>

          <!-- 2. Services -->
          <section class="section section-padding">
            <h2 class="section-title">Services</h2>
            <div class="grid grid-1">
              {cat.children?.map((x, i) => (
                <a class={`card ${tintFor(i)}`} href={x.href}>
                  <h3 class="card-title">{x.title}</h3>
                  <p class="card-desc">Coverage, documents & claim guidance</p>
                </a>
              ))}
            </div>
          </section>

          <!-- 3. Common problems -->
          {cat.problems?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Common problems</h2>
              <ul class="bullets">{cat.problems.map((p) => <li>{p}</li>)}</ul>
            </section>
          ) : null}

          <!-- SMART ASSIST — service category capture (mobile) -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-mob"
            heading="Have a question about this? Send us a message"
            subheading="Pick your situation — we pre-fill the WhatsApp message, you just send."
          />

          <!-- SCENARIOS (mobile) -->
          <ScenariosWeHandle
            title="Real situations we handle"
            scenarios={catScenarios.slice(0, 2)}
            waNumber={waNumber}
          />

          <!-- STILL WONDERING (mobile) -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={catGapQs.slice(0, 3)}
            waNumber={waNumber}
            waText={`Hi, I have a question about ${cat.title}. Can you guide me?`}
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>
      </div>
    </main>

    <GlobalOverlays />

    <style is:inline>
      .grid{display:grid;gap:12px}
      .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
      .grid-1{grid-template-columns:1fr}
      .card{display:block;padding:14px;border:1px solid rgba(255,255,255,.12);border-radius:14px;text-decoration:none}
      .card-title{font-size:16px;margin:0 0 6px}
      .card-desc{margin:0;opacity:.85}
      .readable{max-width:78ch}
      @media (max-width: 980px){.grid-2{grid-template-columns:1fr}}
    </style>
  </body>
</html>
