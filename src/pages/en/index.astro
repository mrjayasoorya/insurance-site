---
// src/pages/en/index.astro
// RESTRUCTURED: Clear user flow — identity → guidance → trust → services → proof → areas → CTA
// Flow: Who we are → What do you need? → How we work → Category banners → Services → Testimonials → Areas → FAQs → CTA

import DesktopHero from "../../components/DesktopHero.astro";
import DesktopCoreServices from "../../components/DesktopCoreServices.astro";
import MobileHero from "../../components/MobileHero.astro";
import MobileCoreServices from "../../components/MobileCoreServices.astro";
import MobileAccordion from "../../components/MobileAccordion.astro";
import TestimonialsStrip from "../../components/TestimonialsStrip.astro";
import FooterCtaBar from "../../components/FooterCtaBar.astro";
import GlobalOverlays from "../../components/GlobalOverlays.astro";
import BacklinksRow from "../../components/BacklinksRow.astro";
import PageActionBar from "../../components/PageActionBar.astro";

import { siteData, EN } from "../../content/siteData";
import { buildJsonLd, buildMeta, canonicalFromPath, geoMetaFromBrand } from "src/lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";


// Services
const serviceCategoryCards = (siteData.serviceCategories || []).map((c) => ({
  tag: "Category",
  title: c.title,
  desc: c.desc,
  href: c.href,
}));

const popularServices = (siteData.servicePopular || []).map((x) => ({ ...x, href: x.href }));

// Locations (curated, not 16+)
const allLocations = siteData.locationsIndex?.groups?.flatMap((g) => g.locations || []) || [];
const featuredLocations = allLocations.slice(0, 6);

// WhatsApp helper
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");
const wa = (text) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;

// Confidence content
const cc = siteData.confidenceContent || {};

// Promo banners
// Category cards link to the real service page — a visitor reads what's
// actually covered before being asked to contact us. Replaced the old
// ad-style banner images (comic "CALL NOW!" starbursts, fake cursor
// graphics) with plain icon + text cards matching the site's calmer,
// advisor-style visual language used elsewhere on this page.
const promoBanners = [
  { key: "car", title: "Car insurance", icon: "🚗", desc: "New policy, renewal or claim support for your car.", href: EN("/services/personal/car-insurance-support/"), tint: "t-teal" },
  { key: "lorry", title: "Lorry insurance", icon: "🚚", desc: "NH-belt permit, fitness and claim documentation.", href: EN("/services/transport-fleet/lorry-insurance/"), tint: "t-amber" },
  { key: "fleet", title: "Fleet / transport operators", icon: "🚛", desc: "Multi-vehicle cover for transport businesses.", href: EN("/services/transport-fleet/fleet-insurance/"), tint: "t-blue" },
  { key: "warehouse", title: "Warehouse & factory", icon: "🏭", desc: "Stock, fire and property cover for industrial units.", href: EN("/services/industrial/warehouse-insurance/"), tint: "t-purple" },
  { key: "crane", title: "Crane / contractor", icon: "🏗️", desc: "CPM and liability cover for equipment and site work.", href: EN("/services/heavy-equipment/crane-cpm-insurance/"), tint: "t-coral" },
  { key: "sme", title: "Shop / SME", icon: "🏪", desc: "Package cover for shops, offices and small businesses.", href: EN("/services/business-msme/shop-msme-insurance/"), tint: "t-green" },
];

// How we work
const howWeWork = siteData.aboutPage?.howWeWork?.steps || [];

// FAQ
const smallHomeFaq = [
  { q: "Do you serve only Sholavaram or all of Chennai?", a: "We serve all of Chennai and a 60km radius. Sholavaram is our office location, but we provide doorstep service across the entire city — North, South, Central, West Chennai and surrounding districts." },
  { q: "Can you help with insurance renewals and policy checks?", a: "Yes. We assist with renewal checks, add-on clarity and documentation discipline to reduce avoidable claim issues later." },
  { q: "Do you work with multiple insurance companies?", a: "Yes. We compare across 15+ public and private insurers including New India Assurance, United India, ICICI Lombard, Bajaj Allianz, HDFC ERGO and more to find the best coverage and pricing." },
];

// SEO
const canonical = canonicalFromPath(siteData.brand.websiteUrl, "/en/");
const meta = buildMeta({
  title: siteData.pageFlow.seoTitle || `${siteData.pageFlow.heroH1} | ${siteData.brand.shortName}`,
  description: siteData.pageFlow.seoDescription || siteData.brand.subtitle,
  canonical,
  geo: geoMetaFromBrand(siteData),
});

const homeFaqPicks = [
  { group: "claimsDocs", index: 0 },
  { group: "claimsDocs", index: 1 },
  { group: "claimsDocs", index: 2 },
  { group: "locationsOffice", index: 0 },
  { group: "locationsOffice", index: 3 },
  { group: "experienceTrust", index: 0 },
];
const homeFaqItems = (homeFaqPicks || [])
  .map(({ group, index }) => siteData.faqsPage?.[group]?.items?.[index])
  .filter(Boolean)
  .slice(0, 6);

const jsonLd = buildJsonLd({
  pageType: "home",
  siteData,
  canonical,
  title: meta.title,
  description: meta.description,
  faqs: homeFaqItems || [],
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <meta name="theme-color" content="#ffffff" />
    <link rel="stylesheet" href="/styles/theme.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class="app">
      <div class="container">

        <!-- ========================= DESKTOP ========================= -->
        <div class="ui-desktop">
          <header>
            <DesktopHero
              heroH1={siteData.pageFlow.heroH1}
              brand={{
                name: siteData.brand.name,
                tagline: siteData.brand.tagline,
                subtitle: siteData.pageFlow.heroP,
                phone: siteData.brand.phone,
                areaChips: siteData.brand.areaChips,
              }}
            />
          </header>

          <main>
            <!-- 1. WHO WE ARE — clear identity + what you can do here -->
            <section class="section section-padding" aria-labelledby="home-intro">
              <h2 id="home-intro" class="section-title">
                M N Rajendrakumar Insurance Services — Sholavaram, Chennai
              </h2>
              <p class="section-sub readable">
                This is a real office in Sholavaram, not a call centre — we've been here 30 years.
                Whether it's your <strong>car, bike, lorry, fleet, warehouse, factory, health or LIC</strong> policy,
                we sit down, understand what you actually have, and tell you honestly what's covered and what isn't.
                Renewals, new policies, or help after an accident — Chennai North, Red Hills, Madhavaram and the industrial belts nearby all come through this office.
              </p>
              <p class="trust-badge-line">
                <span class="trust-badge">🛡️ IRDAI Licensed · No. {siteData.brand.regulatory.licenseNumber}</span>
                <span class="trust-badge">⭐ 4.9 rated on Google</span>
                <span class="trust-badge">📍 Sholavaram office, 30+ yrs</span>
              </p>
              <PageActionBar brand={siteData.brand} context="Home" />
            </section>

            <!-- 1b. WHAT HAPPENS WHEN YOU CALL — sets expectations, lowers first-call anxiety -->
            <section class="section section-padding" aria-labelledby="how-it-works-title">
              <h2 id="how-it-works-title" class="section-title">What happens when you call</h2>
              <div class="how-it-works">
                <div class="hiw-step">
                  <span class="hiw-num">1</span>
                  <div>
                    <h3 class="hiw-title">Tell us your situation</h3>
                    <p class="hiw-desc">New policy, renewal, or a claim that's stuck — just explain what's going on, in your own words.</p>
                  </div>
                </div>
                <div class="hiw-step">
                  <span class="hiw-num">2</span>
                  <div>
                    <h3 class="hiw-title">We check your documents</h3>
                    <p class="hiw-desc">We look at your existing policy or paperwork and tell you honestly what's covered, what's missing, and what it'll cost.</p>
                  </div>
                </div>
                <div class="hiw-step">
                  <span class="hiw-num">3</span>
                  <div>
                    <h3 class="hiw-title">You decide — no pressure</h3>
                    <p class="hiw-desc">No hard sell, no repeated follow-up calls. If you want to go ahead, we handle the paperwork. If not, that's fine too.</p>
                  </div>
                </div>
              </div>
            </section>

            <!-- 2. WHAT DO YOU NEED? — intent guidance for users who don't know where to start -->
            <section class="section section-padding" aria-labelledby="home-guidance">
              <h2 id="home-guidance" class="section-title">What do you need?</h2>
              <p class="section-sub readable">
                Not sure where to start? Pick the option that best describes your situation:
              </p>
              <div class="grid grid-2">
                <a class="card card-highlight" href={EN("/insurance-near-me/")}>
                  <h3 class="card-title">I need insurance help nearby</h3>
                  <p class="card-desc">Find out how to reach us — visit, WhatsApp or phone. We'll tell you what documents to share first.</p>
                </a>
                <a class="card card-highlight" href={EN("/insurance-renewal-near-me/")}>
                  <h3 class="card-title">I need to renew my policy</h3>
                  <p class="card-desc">Expiring or expired? We'll check IDV, NCB, add-ons and do the renewal cleanly.</p>
                </a>
                <a class="card card-highlight" href={EN("/insurance-claim-help/")}>
                  <h3 class="card-title">I need help with a claim</h3>
                  <p class="card-desc">Accident, fire, theft or damage? We guide documents, timeline and filing steps.</p>
                </a>
                <a class="card card-highlight" href={EN("/services/")}>
                  <h3 class="card-title">I want to browse all services</h3>
                  <p class="card-desc">Transport, industrial, construction, business & personal insurance — see what we cover.</p>
                </a>
              </div>
            </section>

            <!-- 4. QUICK HELP BY CATEGORY — links to real service pages, not cold WhatsApp -->
            <section class="section section-padding" aria-labelledby="promo-title">
              <h2 id="promo-title" class="section-title">Browse by category</h2>
              <p class="section-sub readable">
                See what's covered, common mistakes to avoid, and what documents you'll need — before you decide to reach out.
              </p>
              <div class="promo-tiles" role="list" aria-label="Category cards">
                {promoBanners.map((b) => (
                  <a class="promo-tile" role="listitem" href={b.href}>
                    <span class={`promo-icon ${b.tint}`} aria-hidden="true">{b.icon}</span>
                    <span class="promo-tile-text">
                      <h3 class="promo-tile-title">{b.title}</h3>
                      <p class="promo-tile-desc">{b.desc}</p>
                    </span>
                  </a>
                ))}
              </div>
            </section>

            <!-- 5. TESTIMONIALS — social proof after trust is built -->
            <section class="section section-padding" aria-labelledby="reviews-title">
              <TestimonialsStrip
                title="What clients say about us"
                subtitle="Real feedback from lorry owners, factory managers & families in Chennai North belts."
                avgScore="4.9"
                avgText="Average rating · Google reviews"
                pillHref={EN("/reviews/")}
                testimonials={[
                  { name: "Ramesh Kumar", role: "Fleet Owner, Madhavaram", quote: "30 years of experience really shows. He guided us through the lorry claim without any confusion. Documents were correct, claim settled fast.", rating: 5, avatarText: "R" },
                  { name: "Priya Logistics", role: "Warehouse Owner, Manali", quote: "Warehouse fire insurance sorted in one day. He explained sum insured properly so we didn't underinsure. Highly recommend for industrial belts.", rating: 5, avatarText: "P" },
                  { name: "Selvam", role: "Contractor, Poonamallee belt", quote: "CAR + WC insurance for our construction site. No surprises in claim. He calls you back, answers properly. Not just selling and forgetting.", rating: 5, avatarText: "S" },
                ]}
                showControls={false}
              />
            </section>

            <!-- 5b. WHY CHOOSE US — differentiators -->
            <WhyChooseUs
              title="Why work with us"
              subtitle="What makes our approach different from online portals and call centres."
              points={cc.whyUs || []}
            />

            <!-- 5b-ii. COMPARISON TABLE -->
            {siteData.homeComparisonTable?.rows?.length ? (
              <section class="section section-padding" aria-label="Comparison">
                <h2 class="section-title">{siteData.homeComparisonTable.title}</h2>
                <p class="readable">{siteData.homeComparisonTable.intro}</p>
                <table class="compare-table" style="margin-top:16px">
                  <thead>
                    <tr class="compare-header">
                      {siteData.homeComparisonTable.columns.map((c, i) => (
                        <th class={`compare-cell ${i === 0 ? "compare-k" : ""} ${i === siteData.homeComparisonTable.columns.length - 1 ? "compare-us" : ""}`} scope="col">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {siteData.homeComparisonTable.rows.map((r) => (
                      <tr class="compare-row">
                        {r.map((cell, i) => (
                          i === 0
                            ? <th class="compare-cell compare-k" scope="row">{cell}</th>
                            : <td class={`compare-cell ${i === r.length - 1 ? "compare-us" : ""}`}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            ) : null}

            <!-- 5b-iii. GUIDE SECTION -->
            {siteData.homeGuideSection ? (
              <section class="section section-padding" aria-label={siteData.homeGuideSection.title}>
                <h2 class="section-title">{siteData.homeGuideSection.title}</h2>
                <p class="readable">{siteData.homeGuideSection.intro}</p>
                <ul class="bullets" style="margin-top:12px">{siteData.homeGuideSection.points.map((x) => <li>{x}</li>)}</ul>
              </section>
            ) : null}

            <!-- 5c. REAL SITUATIONS WE HANDLE — scenario confidence builder -->
            <ScenariosWeHandle
              title="Real situations we handle"
              subtitle="These are actual scenarios we've guided clients through. If your situation is similar, we can help."
              scenarios={(cc.homeScenarios || []).slice(0, 2)}
              waNumber={waNumber}
            />
            <p class="section-sub" style="margin-top:-6px">
              <a class="chiplink" href={EN("/proof-experience/")}>See more real situations we've handled →</a>
            </p>

            <!-- 5d. STILL WONDERING — thinking gap filler -->
            <ThinkingGapFiller
              title="Still wondering? Here's what people ask before reaching out"
              items={cc.homeGapQuestions || []}
              waNumber={waNumber}
              waText="Hi, I have a question about insurance. Can you help me?"
            />

            <!-- 6. MOST REQUESTED SERVICES — specific service pages -->
            <section class="section section-padding" aria-labelledby="svc-pop-title">
              <h2 id="svc-pop-title" class="section-title">Most requested services</h2>
              <p class="section-sub readable">
                Each page explains what the service covers, what documents you need, and common mistakes to avoid.
              </p>
              <div class="grid grid-2">
                {popularServices.slice(0, 8).map((x) => (
                  <a class="card" href={x.href}>
                    <div class="card-row"><span class="chip">{x.tag}</span></div>
                    <h3 class="card-title">{x.title}</h3>
                    <p class="card-desc readable" title={x.desc || "Open guidance"}>{x.desc || "Open guidance"}</p>
                  </a>
                ))}
              </div>
              <p class="section-sub" style="margin-top:14px">
                <a class="chiplink" href={EN("/services/")}>View all services and categories →</a>
              </p>
            </section>

            <!-- 6b. FOR DEALERS, BUSINESSES & NEW COMPANIES -->
            {siteData.businessAudiences?.length ? (
              <section class="section section-padding" aria-labelledby="biz-aud-title">
                <h2 id="biz-aud-title" class="section-title">For dealers, businesses & new companies</h2>
                <p class="section-sub readable">
                  Set up differently from a single personal policy — one contact across multiple vehicles, policies, or a growing company.
                </p>
                <div class="grid grid-2">
                  {siteData.businessAudiences.map((x) => (
                    <a class="card" href={x.href}>
                      <div class="card-row"><span class="chip">{x.tag}</span></div>
                      <h3 class="card-title">{x.title}</h3>
                      <p class="card-desc readable" title={x.desc}>{x.desc}</p>
                    </a>
                  ))}
                </div>
              </section>
            ) : null}

            <!-- 7. AREAS WE SERVE -->
            <section class="section section-padding" aria-labelledby="loc-title">
              <h2 id="loc-title" class="section-title">Areas we serve from Sholavaram</h2>
              <p class="section-sub readable">
                Our office is in Sholavaram. We support Chennai North, Red Hills, Puzhal, Madhavaram, NH belts and industrial corridors.
                Support scope depends on the policy type and insurer requirements.
              </p>
              <div class="grid grid-2" style="margin-top:12px;">
                <a class="card" href={EN("/locations/")}>
                  <h3 class="card-title">All locations</h3>
                  <p class="card-desc readable">NH belts, logistics hubs, industrial corridors, city-side areas.</p>
                </a>
                <a class="card" href={EN("/insurance-near-me/")}>
                  <h3 class="card-title">Insurance near me</h3>
                  <p class="card-desc readable">How local support works, document checklists, insurer inspections.</p>
                </a>
                {featuredLocations.map((l) => (
                  <a class="card" href={EN(`/locations/${l.slug}/`)}>
                    <h3 class="card-title">{l.name}</h3>
                    <p class="card-desc readable">Local context + services commonly used here</p>
                  </a>
                ))}
              </div>
            </section>

            <!-- 8. FAQs — answers common questions -->
            <section class="section section-padding" aria-labelledby="home-faq-title">
              <h2 id="home-faq-title" class="section-title">Common questions</h2>
              <MobileAccordion
                sections={[
                  { title: "Frequently asked questions", items: smallHomeFaq.map((f) => ({ strong: f.q, text: f.a })) },
                ]}
                defaultOpen={true}
              />
              <p class="section-sub" style="margin-top:14px">
                <a class="chiplink" href={EN("/faqs/")}>View all FAQs →</a>
              </p>
            </section>

            <ConversionBlock siteData={siteData} brand={siteData.brand} />
            <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

            <section aria-labelledby="contact-title">
              <h2 id="contact-title" class="sr-only">Contact</h2>
              <FooterCtaBar
                title={siteData.footerCtas.title}
                subtitle={siteData.footerCtas.subtitle}
                whatsappNumber={siteData.brand.whatsappE164}
                whatsappText={siteData.brand.whatsappPrefill}
                callNumber={siteData.brand.phoneE164}
                callLabel={siteData.footerCtas.callLabel}
                brandName={siteData.footerCtas.brandName}
                logoText={siteData.footerCtas.logoText}
                copyright={siteData.footerCtas.copyright}
              />
            </section>
          </main>
        </div>

        <!-- ========================= MOBILE ========================= -->
        <div class="ui-mobile">
          <header>
            <MobileHero
              heroH1={siteData.pageFlow.heroH1}
              brand={{
                name: siteData.brand.name,
                tagline: siteData.brand.tagline,
                subtitle: siteData.pageFlow.heroP,
                phone: siteData.brand.phone,
                areaChips: [],
              }}
            />
          </header>

          <main>
            <!-- 1. WHO WE ARE -->
            <section class="section section-padding" aria-labelledby="m-home-intro">
              <h2 id="m-home-intro" class="section-title">
                Insurance office in Sholavaram, Chennai
              </h2>
              <p class="section-sub readable">
                A real office, not a call centre — 30 years in Sholavaram. Car, bike, lorry, fleet, warehouse, factory, health & LIC insurance, explained straight.
                Call <strong>7448324068</strong> or WhatsApp and we'll tell you honestly what you need.
              </p>
              <p class="trust-badge-line">
                <span class="trust-badge">🛡️ IRDAI Licensed · No. {siteData.brand.regulatory.licenseNumber}</span>
                <span class="trust-badge">⭐ 4.9 rated on Google</span>
                <span class="trust-badge">📍 Sholavaram office, 30+ yrs</span>
              </p>
            </section>

            <!-- 1b. WHAT HAPPENS WHEN YOU CALL -->
            <section class="section section-padding" aria-labelledby="m-how-it-works-title">
              <h2 id="m-how-it-works-title" class="section-title">What happens when you call</h2>
              <div class="how-it-works">
                <div class="hiw-step">
                  <span class="hiw-num">1</span>
                  <div>
                    <h3 class="hiw-title">Tell us your situation</h3>
                    <p class="hiw-desc">New policy, renewal, or a stuck claim — explain what's going on.</p>
                  </div>
                </div>
                <div class="hiw-step">
                  <span class="hiw-num">2</span>
                  <div>
                    <h3 class="hiw-title">We check your documents</h3>
                    <p class="hiw-desc">We tell you honestly what's covered, what's missing, and what it'll cost.</p>
                  </div>
                </div>
                <div class="hiw-step">
                  <span class="hiw-num">3</span>
                  <div>
                    <h3 class="hiw-title">You decide — no pressure</h3>
                    <p class="hiw-desc">No hard sell, no repeated follow-up calls.</p>
                  </div>
                </div>
              </div>
            </section>

            <!-- 2. WHAT DO YOU NEED? -->
            <section class="section section-padding" aria-labelledby="m-home-guidance">
              <h2 id="m-home-guidance" class="section-title">What do you need?</h2>
              <div class="grid grid-1">
                <a class="card card-highlight" href={EN("/insurance-near-me/")}>
                  <h3 class="card-title">I need insurance help nearby</h3>
                  <p class="card-desc">How to reach us — visit, WhatsApp or phone.</p>
                </a>
                <a class="card card-highlight" href={EN("/insurance-renewal-near-me/")}>
                  <h3 class="card-title">I need to renew my policy</h3>
                  <p class="card-desc">Expiring or expired? We'll handle it cleanly.</p>
                </a>
                <a class="card card-highlight" href={EN("/insurance-claim-help/")}>
                  <h3 class="card-title">I need help with a claim</h3>
                  <p class="card-desc">Documents, timeline and filing guidance.</p>
                </a>
                <a class="card card-highlight" href={EN("/services/")}>
                  <h3 class="card-title">Browse all services</h3>
                  <p class="card-desc">Transport, industrial, construction & personal insurance.</p>
                </a>
              </div>
            </section>

            <!-- 4. CATEGORY BANNERS -->
            <section class="section section-padding" aria-labelledby="m-promo-title">
              <h2 id="m-promo-title" class="section-title">Browse by category</h2>
              <p class="section-sub readable">
                Tap a category to see what's covered before you reach out.
              </p>
              <div class="promo-tiles promo-tiles--mobile" role="list" aria-label="Category cards">
                {promoBanners.map((b) => (
                  <a class="promo-tile" role="listitem" href={b.href}>
                    <span class={`promo-icon ${b.tint}`} aria-hidden="true">{b.icon}</span>
                    <span class="promo-tile-text">
                      <h3 class="promo-tile-title">{b.title}</h3>
                      <p class="promo-tile-desc">{b.desc}</p>
                    </span>
                  </a>
                ))}
              </div>
            </section>

            <!-- 5. TESTIMONIALS -->
            <section class="section section-padding" aria-labelledby="m-reviews-title">
              <TestimonialsStrip
                title="What clients say"
                subtitle="Lorry owners, factories & families in Chennai North."
                avgScore="4.9"
                avgText="Google reviews"
                pillHref={EN("/reviews/")}
                testimonials={[
                  { name: "Ramesh Kumar", role: "Fleet Owner, Madhavaram", quote: "Lorry claim settled fast. Documents sorted, no confusion. 30 years experience really shows.", rating: 5, avatarText: "R" },
                  { name: "Priya Logistics", role: "Warehouse, Manali", quote: "Warehouse fire insurance done in one day. Explained sum insured properly. Recommend for industrial belt.", rating: 5, avatarText: "P" },
                  { name: "Selvam", role: "Contractor, Poonamallee", quote: "CAR + WC insurance for construction site. No surprises in claim. Calls back and answers properly.", rating: 5, avatarText: "S" },
                ]}
                showControls={false}
              />
            </section>

            <!-- 5b. WHY CHOOSE US -->
            <WhyChooseUs
              title="Why work with us"
              subtitle="What makes us different from online portals and call centres."
              points={cc.whyUs || []}
            />

            <!-- 5b-ii. COMPARISON TABLE (mobile) -->
            {siteData.homeComparisonTable?.rows?.length ? (
              <section class="section section-padding">
                <h2 class="section-title">{siteData.homeComparisonTable.title}</h2>
                <p class="readable">{siteData.homeComparisonTable.intro}</p>
                <div style="overflow-x:auto">
                  <table class="compare-table" style="margin-top:16px;min-width:480px">
                    <thead>
                      <tr class="compare-header">
                        {siteData.homeComparisonTable.columns.map((c, i) => (
                          <th class={`compare-cell ${i === 0 ? "compare-k" : ""} ${i === siteData.homeComparisonTable.columns.length - 1 ? "compare-us" : ""}`} scope="col">{c}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {siteData.homeComparisonTable.rows.map((r) => (
                        <tr class="compare-row">
                          {r.map((cell, i) => (
                            i === 0
                              ? <th class="compare-cell compare-k" scope="row">{cell}</th>
                              : <td class={`compare-cell ${i === r.length - 1 ? "compare-us" : ""}`}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            ) : null}

            <!-- 5b-iii. GUIDE SECTION (mobile) -->
            {siteData.homeGuideSection ? (
              <section class="section section-padding">
                <h2 class="section-title">{siteData.homeGuideSection.title}</h2>
                <p class="readable">{siteData.homeGuideSection.intro}</p>
                <ul class="bullets" style="margin-top:12px">{siteData.homeGuideSection.points.map((x) => <li>{x}</li>)}</ul>
              </section>
            ) : null}

            <!-- 5c. REAL SITUATIONS -->
            <ScenariosWeHandle
              title="Real situations we handle"
              subtitle="If your situation is similar, we can help."
              scenarios={(cc.homeScenarios || []).slice(0, 2)}
              waNumber={waNumber}
            />
            <p class="section-sub" style="margin-top:-6px">
              <a class="chiplink" href={EN("/proof-experience/")}>See more real situations →</a>
            </p>

            <!-- 5d. STILL WONDERING -->
            <ThinkingGapFiller
              title="Still wondering?"
              items={(cc.homeGapQuestions || []).slice(0, 4)}
              waNumber={waNumber}
              waText="Hi, I have a question about insurance. Can you help me?"
            />

            <!-- 6. MOST REQUESTED SERVICES -->
            <section class="section section-padding">
              <h2 class="section-title">Most requested services</h2>
              <div class="grid grid-1">
                {popularServices.slice(0, 6).map((x) => (
                  <a class="card" href={x.href}>
                    <div class="card-row"><span class="chip">{x.tag}</span></div>
                    <h3 class="card-title">{x.title}</h3>
                    <p class="card-desc readable" title={x.desc || "Open"}>{x.desc || "Open"}</p>
                  </a>
                ))}
              </div>
              <p class="section-sub" style="margin-top:14px">
                <a class="chiplink" href={EN("/services/")}>All services →</a>
              </p>
            </section>

            <!-- 6b. FOR DEALERS, BUSINESSES & NEW COMPANIES -->
            {siteData.businessAudiences?.length ? (
              <section class="section section-padding">
                <h2 class="section-title">For dealers, businesses & new companies</h2>
                <div class="grid grid-1">
                  {siteData.businessAudiences.map((x) => (
                    <a class="card" href={x.href}>
                      <div class="card-row"><span class="chip">{x.tag}</span></div>
                      <h3 class="card-title">{x.title}</h3>
                      <p class="card-desc readable" title={x.desc}>{x.desc}</p>
                    </a>
                  ))}
                </div>
              </section>
            ) : null}

            <!-- 7. AREAS WE SERVE -->
            <section class="section section-padding" aria-label="Locations">
              <h2 class="section-title">Areas we serve</h2>
              <div class="grid grid-1">
                <a class="card" href={EN("/locations/")}>
                  <h3 class="card-title">All locations</h3>
                  <p class="card-desc readable">NH belts, logistics hubs, industrial corridors, city-side areas.</p>
                </a>
                <a class="card" href={EN("/insurance-near-me/")}>
                  <h3 class="card-title">Insurance near me</h3>
                  <p class="card-desc readable">How local support works + documents to share first.</p>
                </a>
                {featuredLocations.slice(0, 4).map((l) => (
                  <a class="card" href={EN(`/locations/${l.slug}/`)}>
                    <h3 class="card-title">{l.name}</h3>
                    <p class="card-desc readable">Open local guide</p>
                  </a>
                ))}
              </div>
            </section>

            <!-- 8. FAQs -->
            <section class="section section-padding">
              <h2 class="section-title">Common questions</h2>
              <MobileAccordion
                sections={[
                  { title: "Frequently asked questions", items: smallHomeFaq.map((f) => ({ strong: f.q, text: f.a })) },
                ]}
                defaultOpen={true}
              />
              <p class="section-sub" style="margin-top:14px">
                <a class="chiplink" href={EN("/faqs/")}>All FAQs →</a>
              </p>
            </section>

            <ConversionBlock siteData={siteData} brand={siteData.brand} />
            <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

            <div style="height:90px" aria-hidden="true"></div>

            <FooterCtaBar
              title={siteData.footerCtas.title}
              subtitle={siteData.footerCtas.subtitle}
              whatsappNumber={siteData.brand.whatsappE164}
              whatsappText={siteData.brand.whatsappPrefill}
              callNumber={siteData.brand.phoneE164}
              callLabel={siteData.footerCtas.callLabel}
              brandName={siteData.footerCtas.brandName}
              logoText={siteData.footerCtas.logoText}
              copyright={siteData.footerCtas.copyright}
            />
          </main>
        </div>

      </div>
    </main>
    <GlobalOverlays />

    <style is:inline>
      .readable { max-width: 78ch; }
      @media (min-width: 820px){ .readable { max-width: 100% !important; } }

      .grid { display:grid; gap:12px; }
      .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-1 { grid-template-columns: 1fr; }

      .card{
        display:block;
        padding:14px;
        border:1px solid var(--border, #e7e9ee);
        border-radius:14px;
        text-decoration:none;
        color:#14161c;
      }
      .card-highlight{
        border-left: 3px solid #bdeee5;
      }
      .card-highlight:nth-child(4n+1){ border-left-color:#0d9488; }
      .card-highlight:nth-child(4n+2){ border-left-color:#7c3aed; }
      .card-highlight:nth-child(4n+3){ border-left-color:#1d4ed8; }
      .card-highlight:nth-child(4n+4){ border-left-color:#b45309; }
      .card-title{ font-size:16px; margin:8px 0 6px; }
      .card-desc{ margin:0; opacity:.85; }
      .card-row{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }

      .chip{
        display:inline-block;
        padding:4px 10px;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.18);
        font-size:12px;
        opacity:.92;
      }

      .chiplink{
        display:inline-flex;
        align-items:center;
        padding:8px 12px;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.16);
        text-decoration:none;
      }

      .steps-list{list-style:none;padding:0;margin:12px 0 0;display:flex;flex-direction:column;gap:12px}
      .step-item{display:flex;gap:14px;align-items:flex-start}
      .step-num{width:32px;height:32px;border-radius:50%;border:1px solid var(--border);display:grid;place-items:center;font-weight:900;flex:0 0 auto}
      .step-desc{margin:4px 0 0;opacity:.85}

      /* Trust badges — IRDAI license, rating, office, shown right under the intro */
      .trust-badge-line{
        display:flex; flex-wrap:wrap; gap:8px;
        margin:12px 0 0; padding:0; list-style:none;
      }
      .trust-badge{
        display:inline-flex; align-items:center; gap:6px;
        padding:6px 12px;
        border-radius:999px;
        background:#f0f2f7;
        border:1px solid #e2e5ee;
        font-size:12.5px; font-weight:700;
        color:#2a2d36;
      }

      /* What happens when you call — 3-step expectation setter */
      .how-it-works{
        display:grid;
        grid-template-columns: repeat(3, 1fr);
        gap:18px;
        margin-top:8px;
      }
      .hiw-step{ display:flex; gap:12px; align-items:flex-start; }
      .hiw-num{
        flex:0 0 auto;
        width:30px; height:30px; border-radius:50%;
        display:grid; place-items:center;
        background:#e6faf6; color:#0d9488;
        font-weight:900; font-size:14px;
      }
      .hiw-title{ font-size:15px; font-weight:800; margin:2px 0 4px; }
      .hiw-desc{ font-size:13.5px; opacity:.85; margin:0; line-height:1.45; }
      @media (max-width:820px){
        .how-it-works{ grid-template-columns: 1fr; gap:16px; }
      }

      /* Category tiles — flat row: colored icon badge + text, no card fill */
      .promo-tiles{
        display:grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap:4px 24px;
      }
      .promo-tiles--mobile{
        grid-template-columns: 1fr;
      }
      .promo-tile{
        position:relative;
        display:flex;
        align-items:center;
        gap:14px;
        padding:14px 4px;
        border-bottom:1px solid var(--border, #e7e9ee);
        text-decoration:none;
        color:#14161c;
        transition: opacity 160ms ease;
      }
      .promo-tile:hover{
        opacity:.7;
      }
      .promo-icon{
        flex:0 0 auto;
        width:42px; height:42px;
        border-radius:50%;
        display:grid; place-items:center;
        font-size:19px; line-height:1;
      }
      .promo-tile-text{ min-width:0; }
      .promo-tile-title{
        font-size:15px; font-weight:800; margin:0 0 2px; color:#14161c;
      }
      .promo-tile-desc{
        font-size:13px; margin:0; color:#4a4f5c; line-height:1.35;
      }

      /* Six distinct icon-badge tints so each category is visually distinct */
      .t-teal{ background:#e6faf6; }
      .t-amber{ background:#fff4e0; }
      .t-blue{ background:#e8f1ff; }
      .t-purple{ background:#f4edff; }
      .t-coral{ background:#ffeeee; }
      .t-green{ background:#eafbe9; }

      @media (max-width: 980px){
        .grid-2 { grid-template-columns: 1fr; }
      }

      .compare-table{width:100%;border:1px solid var(--border,#e7e9ee);border-radius:12px;overflow:hidden;border-collapse:collapse}
      .compare-header, .compare-row{display:table-row}
      .compare-header{background:var(--surface,#f7f8fa);font-weight:900;font-size:13px}
      .compare-row{border-top:1px solid var(--border,#e7e9ee)}
      .compare-cell{display:table-cell;padding:10px 12px;font-size:13px;line-height:1.35;text-align:left;font-weight:400}
      .compare-k{font-weight:700;opacity:.85}
      .compare-us{background:rgba(46,125,50,.06);font-weight:600}
      @media (max-width:520px){.compare-header{font-size:11px}.compare-cell{padding:8px 6px}}
    </style>
  </body>
</html>
