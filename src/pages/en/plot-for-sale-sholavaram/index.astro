---
// Standalone real-estate landing page. Intentionally does NOT use the site's
// insurance SEO layout/meta/schema — this page targets plot-sale search intent only.
// Listing: Arimaa KVG Nagar, Sholavaram Village, Ponneri Taluk, Thiruvallur District.
// CMDA Approved No. 190/2022. RERA Approved. Two plots on sale.
const PHONE_E164 = "+917448324068";
const WA_NUMBER = "917448324068";
const WA_TEXT = encodeURIComponent(
  "Hi, interested in the CMDA approved plot at Arimaa KVG Nagar Sholavaram. Please share details and a site visit slot."
);
const WA_URL = `https://wa.me/${WA_NUMBER}?text=${WA_TEXT}`;
const TEL_URL = `tel:${PHONE_E164}`;
// TODO: replace with the real Google Maps pin for Arimaa KVG Nagar once shared.
const OFFICE_MAPS_URL = "https://maps.app.goo.gl/42H8Ev6Rg6gVeiFQ8";
const LAYOUT_MAP_URL = "/assets/plots/arimaa-kvg-nagar-sholavaram-layout.png";
const OFFICE_NAME = "M N Rajendrakumar Insurance Services";
const OFFICE_LAT = 13.2391084;
const OFFICE_LNG = 80.1728337;
const PAGE_URL = "https://insuranceconsult.in/en/plot-for-sale-sholavaram/";
const PAGE_URL_TA = "https://insuranceconsult.in/ta/manai-vilpanaikku-sholavaram/";

const faqs = [
  {
    q: "Is this layout CMDA and RERA approved?",
    a: "Yes, both. Arimaa KVG Nagar is CMDA approved (Approval No. 190/2022) in Survey Nos. 327/1, 2, 3B of Sholavaram Village, Ponneri Taluk, Thiruvallur District, and it's RERA approved as well. Ask for both numbers in writing, and check the RERA one yourself on rera.tn.gov.in before you book.",
  },
  {
    q: "What plots are available right now, and what do they cost?",
    a: "Two plots: 1,096 sq.ft for ₹26,30,400, and 1,231 sq.ft for ₹29,54,400 — both at ₹2,400/sq.ft. These are the total plot prices. Registration, documentation, and other statutory charges come extra, paid separately when you register.",
  },
  {
    q: "Which way do these plots face?",
    a: "Both are west facing. Facing is a Vastu and personal-comfort factor in Tamil Nadu, not a legal or structural one — weigh it alongside price, road width, and location when you visit.",
  },
  {
    q: "Is a broker involved anywhere in this?",
    a: "No. This is a direct sale from the owner. No brokerage, at any stage — not when you enquire, not when you negotiate, not at registration.",
  },
  {
    q: "What's an individual patta, and why should I care?",
    a: "It's a separate ownership record for your specific plot, not a joint or undivided one shared with other plot owners. It means you can register and hold the plot in your own name, independently — which is what most banks want to see before approving a loan against the land.",
  },
  {
    q: "How wide are the roads inside the layout?",
    a: "Between 7.2 m and 12 m depending on which avenue, plus a wider road running along the internal park. Ask for the exact width in front of your specific plot number when you visit.",
  },
  {
    q: "Can I start construction right away?",
    a: "Yes. It's a gated layout with EB power and water already nearby, so you're not stuck waiting for basic connections before you can start building.",
  },
  {
    q: "Where exactly is Arimaa KVG Nagar?",
    a: "In Sholavaram Village, Ponneri Taluk, Thiruvallur District — close to GNT Road and Sholavaram Bazaar. Nearby: Sholavaram BDO Office, Sholavaram Government Higher Secondary School, Vinayagar Temple, Sengalamman Temple, and KVT Smart City. Orakkadu Road runs past the layout and is also the local bus route.",
  },
  {
    q: "How do I make sure this layout is genuine before I pay anything?",
    a: "Three checks you can do yourself: (1) verify CMDA Approval No. 190/2022 against this survey number, (2) check the RERA registration on rera.tn.gov.in, (3) ask to see the parent document, the approved layout plan, and the individual patta in person before you book.",
  },
  {
    q: "Can I negotiate on price?",
    a: "This is a direct conversation between you and the owner, no broker markup in between — so yes, there's room to talk. Bring it up on WhatsApp or when you visit.",
  },
  {
    q: "How do I fix a site visit?",
    a: "Message on WhatsApp or call, and we'll fix a time that works for you. Seeing the plot boundaries, the road access, and what's around it in person makes the decision a lot easier.",
  },
  {
    q: "How do I choose between Plot 1 (1,096 sq.ft) and Plot 2 (1,231 sq.ft)?",
    a: "Same rate for both — ₹2,400/sq.ft — so the ₹3,24,000 difference is just the extra 135 sq.ft in Plot 2. It usually comes down to your budget and how much extra frontage or depth you actually need, not one plot being a better deal than the other.",
  },
  {
    q: "Does west facing hurt resale value?",
    a: "Not really. East and north facing plots tend to get picked first for Vastu reasons in Tamil Nadu, which can make west-facing plots a bit more accessibly priced in the same layout — but it's not a legal or structural downside. Plenty of buyers go for west-facing plots without any trouble, especially when the price, road, and location are right.",
  },
  {
    q: "How well connected is Sholavaram, and does that affect land value?",
    a: "Sholavaram sits where MTC bus routes, the Outer Ring Road (SH-234), and NH-16 (GNT Road) all meet, with the Madhavaram Metro (Chennai Metro Phase 2) coming up about 10-12 km away. Good connectivity usually helps land value in a belt over time, but that's not a guarantee for any one plot — check the current status of these projects yourself.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "CMDA Approved Residential Plots, Arimaa KVG Nagar, Sholavaram",
  description:
    "1,096 sq.ft and 1,231 sq.ft CMDA approved (No. 190/2022), RERA approved, west-facing residential plots in Arimaa KVG Nagar, Sholavaram Village, Ponneri Taluk. Individual patta, direct owner sale, no brokerage.",
  image: `https://insuranceconsult.in${LAYOUT_MAP_URL}`,
  url: PAGE_URL,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "INR",
    lowPrice: "2630400",
    highPrice: "2954400",
    offerCount: "2",
    availability: "https://schema.org/InStock",
    url: PAGE_URL,
    seller: {
      "@type": "LocalBusiness",
      name: OFFICE_NAME,
    },
  },
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: OFFICE_NAME,
  telephone: PHONE_E164,
  hasMap: OFFICE_MAPS_URL,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Arimaa KVG Nagar, Sholavaram Village, Ponneri Taluk",
    addressLocality: "Sholavaram",
    addressRegion: "Tamil Nadu",
    postalCode: "600067",
    addressCountry: "IN",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: OFFICE_LAT,
    longitude: OFFICE_LNG,
  },
};

const title =
  "CMDA Approved Plots for Sale in Sholavaram, Red Hills – Arimaa KVG Nagar | ₹2400/sq.ft";
const description =
  "1096 & 1231 sq.ft CMDA approved (No. 190/2022) west-facing plots in gated community, Sholavaram, Ponneri Taluk. Individual patta, direct owner sale, no brokerage. Call for site visit.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#0a6e4f" />
<meta name="format-detection" content="telephone=no" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="keywords" content="CMDA approved plots Sholavaram, RERA plot Red Hills Chennai, Arimaa KVG Nagar, plot for sale Ponneri Taluk, west facing plot Sholavaram, individual patta plot Chennai, direct owner plot no brokerage, thattu manai Sholavaram, veedu manai Ponneri" />
<link rel="canonical" href={PAGE_URL} />
<link rel="alternate" hreflang="en" href={PAGE_URL} />
<link rel="alternate" hreflang="ta" href={PAGE_URL_TA} />
<link rel="alternate" hreflang="x-default" href={PAGE_URL} />

<meta property="og:type" content="product" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={PAGE_URL} />
<meta property="og:image" content={`https://insuranceconsult.in${LAYOUT_MAP_URL}`} />
<meta property="og:site_name" content="Plots for Sale — Arimaa KVG Nagar, Sholavaram" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`https://insuranceconsult.in${LAYOUT_MAP_URL}`} />

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<style is:inline>
  :root {
    --ink: #0f2419;
    --ink-soft: #3d5348;
    --green: #0a6e4f;
    --green-dark: #074d38;
    --green-pale: #e9f5ef;
    --border: #d8e6de;
    --bg: #ffffff;
    --amber: #b5730a;
    --amber-pale: #fdf3e3;
    --wa: #1fae5c;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.55;
    overflow-x: hidden;
    width: 100%;
    -webkit-font-smoothing: antialiased;
  }
  @media (max-width: 759px) { body { padding-bottom: 84px; } }
  img, svg, iframe { max-width: 100%; }
  h1, h2, h3 { font-family: inherit; color: var(--ink); line-height: 1.25; }
  h1 { font-size: clamp(1.5rem, 6vw, 2.2rem); margin: 0 0 10px; letter-spacing: -0.01em; font-weight: 800; }
  h2 { font-size: clamp(1.3rem, 5.5vw, 1.6rem); margin: 0 0 14px; border-left: 5px solid var(--green); padding-left: 12px; }
  h3 { font-size: 1.05rem; margin: 0 0 8px; }
  p { margin: 0 0 12px; }
  section { max-width: 880px; margin: 0 auto; padding: 36px 16px; }
  @media (min-width: 640px) { section { padding: 48px 24px; } }
  section + section { border-top: 1px solid var(--border); }
  a { color: var(--green-dark); }
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .reveal.in-view { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
  table { width: 100%; min-width: 480px; border-collapse: collapse; margin: 0; font-size: 0.94rem; }
  caption { caption-side: top; text-align: left; font-weight: 600; margin-bottom: 6px; color: var(--ink-soft); }
  th, td { text-align: left; padding: 9px 10px; border: 1px solid var(--border); vertical-align: top; }
  th { background: var(--green-pale); color: var(--green-dark); font-weight: 700; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .table-wrap {
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    margin: 14px 0; max-width: 100%;
    border-radius: 8px;
    box-shadow: inset -14px 0 12px -12px rgba(0,0,0,0.06);
  }
  @media (max-width: 480px) {
    table { min-width: 420px; font-size: 0.84rem; }
    th, td { padding: 7px 8px; }
  }
  .table-label {
    font-weight: 700; color: var(--ink-soft); font-size: 0.86rem;
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    margin: 18px 0 10px; text-transform: uppercase; letter-spacing: 0.02em;
  }
  @media (min-width: 561px) { .table-label { display: none; } }
  .kv-table { min-width: 0; }
  .kv-table th { width: auto; font-weight: 600; white-space: normal; }
  .kv-table td.num { white-space: normal; }
  @media (max-width: 560px) {
    caption { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 0.82rem; }
    .kv-table, .kv-table tbody { display: block; width: 100%; }
    .kv-table { min-width: 0; }
    .kv-table tr {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      width: 100%; padding: 9px 2px; border: none; border-bottom: 1px solid var(--border);
    }
    .kv-table tr:last-child { border-bottom: none; }
    .kv-table th, .kv-table td {
      display: block; width: auto; border: none; padding: 0;
      background: transparent;
    }
    .kv-table th {
      font-weight: 500; font-size: 0.70rem; color: var(--ink-soft); flex: 1 1 auto;
    }
    .kv-table th .estimate-tag { display: block; margin: 3px 0 0; width: fit-content; }
    .kv-table td.num {
      text-align: right; font-size: 0.92rem; font-weight: 800; color: var(--green-dark);
      flex: 0 0 auto; white-space: nowrap;
    }
    .kv-table tr.total-row {
      margin-top: 4px; padding: 10px 10px; border: 1.5px solid var(--green);
      border-radius: 10px; background: var(--green-pale);
    }
    .kv-table tr.total-row th { color: var(--green-dark); font-weight: 700; }
    .kv-table tr.total-row td.num { font-size: 1.15rem; }
    .route-table caption, .route-table thead { display: none; }
    .route-table, .route-table tbody { display: block; width: 100%; min-width: 0; }
    .route-table tr {
      display: block; width: 100%; padding: 12px 0; border: none;
      border-bottom: 1px solid var(--border);
    }
    .route-table tr:last-child { border-bottom: none; }
    .route-table td { display: block; border: none; padding: 0; width: auto; }
    .route-table td:first-child {
      display: inline-block; background: var(--green-dark); color: #fff; font-weight: 700;
      font-size: 0.78rem; padding: 4px 9px; border-radius: 6px; white-space: nowrap;
      margin-bottom: 6px;
    }
    .route-table td:not(:first-child)::before {
      content: attr(data-label); display: block; font-size: 0.68rem; font-weight: 600;
      color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.02em; margin: 6px 0 2px;
    }
    .route-table td:nth-child(2) { font-size: 0.9rem; font-weight: 600; color: var(--ink); }
    .compact-table caption, .compact-table thead { display: none; }
    .compact-table, .compact-table tbody { display: block; width: 100%; min-width: 0; }
    .compact-table tr {
      display: block; width: 100%; padding: 12px 14px; margin-bottom: 10px;
      border: 1px solid var(--border); border-radius: 10px; background: #fbfdfc;
    }
    .compact-table tr:last-child { margin-bottom: 0; }
    .compact-table td {
      display: block; border: none; padding: 0; width: auto; white-space: normal;
    }
    .compact-table td:first-child {
      font-weight: 700; color: var(--green-dark); font-size: 0.95rem;
      margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid var(--border);
    }
    .compact-table td.num:not(:first-child)::before {
      content: attr(data-label); display: block; font-size: 0.68rem; font-weight: 600;
      color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.02em; margin: 6px 0 2px;
    }
    .compact-table td.num { text-align: left; font-size: 0.92rem; font-weight: 800; color: var(--ink); }
    .plot-compare-table td:nth-child(2) {
      display: inline-block; background: var(--green-pale); color: var(--green-dark);
      border-radius: 6px; padding: 3px 8px; font-size: 0.82rem; font-weight: 700;
      margin-bottom: 14px;
    }
    .plot-compare-table td:nth-child(2)::before { content: "Rate: "; text-transform: none; font-weight: 700; color: inherit; display: inline; margin: 0; letter-spacing: 0; }
    .plot-compare-table td:nth-child(3), .plot-compare-table td:nth-child(4),
    .plot-compare-table td:nth-child(5), .plot-compare-table td:nth-child(6) {
      padding-left: 12px; padding-right: 12px;
    }
    .plot-compare-table td:nth-child(3) {
      background: var(--green-pale); border: 1px solid var(--green); border-bottom: none;
      border-radius: 10px 10px 0 0; padding-top: 10px; margin-top: 6px;
    }
    .plot-compare-table td:nth-child(3)::before {
      content: "PLOT 1 — 1,096 SQ.FT"; color: var(--green-dark); font-size: 0.7rem;
      letter-spacing: 0.03em; margin-bottom: 6px;
    }
    .plot-compare-table td:nth-child(4) {
      background: var(--green-pale); border: 1px solid var(--green); border-top: none;
      border-radius: 0 0 10px 10px; padding-bottom: 12px; margin-bottom: 10px;
    }
    .plot-compare-table td:nth-child(5) {
      background: #fff; border: 1px solid var(--border); border-bottom: none;
      border-radius: 10px 10px 0 0; padding-top: 10px;
    }
    .plot-compare-table td:nth-child(5)::before {
      content: "PLOT 2 — 1,231 SQ.FT"; color: var(--ink-soft); font-size: 0.7rem;
      letter-spacing: 0.03em; margin-bottom: 6px;
    }
    .plot-compare-table td:nth-child(6) {
      background: #fff; border: 1px solid var(--border); border-top: none;
      border-radius: 0 0 10px 10px; padding-bottom: 12px;
    }
  }
  .badge-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--green-pale); color: var(--green-dark);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 6px 12px; font-size: 0.85rem; font-weight: 600;
  }
  .hero {
    background: linear-gradient(180deg, var(--green-pale), #fff);
    padding: 44px 18px 32px;
  }
  .hero .eyebrow { color: var(--green-dark); font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; font-size: 0.8rem; margin-bottom: 10px; }
  .hero .lede { font-size: 1.05rem; color: var(--ink-soft); max-width: 60ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 15px 22px; border-radius: 12px; font-weight: 700; font-size: 1rem;
    text-decoration: none; border: 2px solid transparent; cursor: pointer;
    min-height: 52px; flex: 1 1 auto;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:active { transform: scale(0.97); }
  .btn-wa { background: var(--wa); color: #fff; box-shadow: 0 6px 16px rgba(31,174,92,0.28); }
  .btn-call { background: #fff; color: var(--green-dark); border-color: var(--green-dark); }
  .btn-maps { background: #fff; color: var(--green-dark); border-color: var(--border); }
  @media (max-width: 480px) { .cta-row .btn { flex: 1 1 100%; } }
  .stat-strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 18px 0 6px; }
  @media (min-width: 480px) { .stat-strip { grid-template-columns: repeat(4, 1fr); } }
  .stat-pill {
    background: #fff; border: 1px solid var(--border); min-width: 0;
    border-radius: 12px; padding: 10px 14px;
    box-shadow: 0 2px 8px rgba(10,110,79,0.06);
  }
  .stat-pill .num { display: block; font-size: 1.25rem; font-weight: 800; color: var(--green-dark); line-height: 1.1; }
  .stat-pill .lbl { display: block; font-size: 0.72rem; color: var(--ink-soft); margin-top: 2px; }
  .estimate-tag {
    display: inline-block; font-size: 0.72rem; font-weight: 700;
    background: var(--amber-pale); color: var(--amber);
    border: 1px solid #f0d9ab; border-radius: 5px; padding: 2px 7px;
    margin-left: 6px; vertical-align: middle; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .plots { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; }
  @media (min-width: 620px) { .plots { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .card {
    border: 1px solid var(--border); border-radius: 14px; padding: 20px;
    background: #fff; min-width: 0;
  }
  .card.accent { border-color: var(--green); box-shadow: 0 0 0 1px var(--green) inset; }
  .card h3 { color: var(--green-dark); }
  .note {
    background: var(--amber-pale); border: 1px solid #f0d9ab; border-radius: 10px;
    padding: 12px 14px; font-size: 0.9rem; color: #5c3d05; margin: 12px 0;
  }
  .disclaimer {
    background: #f4f6f5; border: 1px dashed var(--border); border-radius: 10px;
    padding: 12px 14px; font-size: 0.85rem; color: var(--ink-soft); margin: 14px 0;
  }
  .total-row td, .total-row th { font-weight: 800; background: var(--green-pale); }
  .icon { width: 20px; height: 20px; flex-shrink: 0; }
  ul.check { list-style: none; padding: 0; margin: 0 0 12px; }
  ul.check li { padding-left: 26px; position: relative; margin-bottom: 8px; }
  ul.check li::before { content: "✓"; position: absolute; left: 0; color: var(--green); font-weight: 800; }
  .steps { counter-reset: step; list-style: none; padding: 0; margin: 0; }
  .steps li {
    counter-increment: step; position: relative; padding: 12px 0 12px 44px; border-bottom: 1px solid var(--border);
  }
  .steps li:last-child { border-bottom: none; }
  .steps li::before {
    content: counter(step); position: absolute; left: 0; top: 10px;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--green); color: #fff; font-weight: 800;
    display: flex; align-items: center; justify-content: center; font-size: 0.9rem;
  }
  .faq-item { border-bottom: 1px solid var(--border); padding: 4px 0; }
  .faq-item h3 { color: var(--green-dark); font-size: 1rem; margin: 0; display: inline; }
  .faq-item summary {
    list-style: none; cursor: pointer; padding: 14px 28px 14px 0; position: relative;
    -webkit-tap-highlight-color: transparent;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "+"; position: absolute; right: 2px; top: 10px;
    font-size: 1.4rem; font-weight: 700; color: var(--green); line-height: 1;
    width: 24px; height: 24px; text-align: center; transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item p { padding-bottom: 12px; }
  .office-box {
    display: flex; gap: 14px; align-items: flex-start; background: var(--green-pale);
    border-radius: 12px; padding: 16px; margin: 14px 0;
  }
