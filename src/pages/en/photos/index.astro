---
// RESTRUCTURED: Added Breadcrumbs, PageActionBar, "what to do next" guidance, CTA. Removed LocalIdentitySection.

import DesktopHero from "../../../components/DesktopHero.astro";
import MobileHero from "../../../components/MobileHero.astro";
import Breadcrumbs from "src/components/Breadcrumbs.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import FooterCtaBar from "../../../components/FooterCtaBar.astro";
import GlobalOverlays from "../../../components/GlobalOverlays.astro";
import BacklinksRow from "../../../components/BacklinksRow.astro";

import { siteData, EN } from "../../../content/siteData";
import { buildJsonLd, buildMeta, canonicalFromPath, geoMetaFromBrand } from "src/lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import UserQuestionsBlock from "src/components/UserQuestionsBlock.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";

const brand = siteData.brand;
const cc = siteData.confidenceContent || {};
const page = siteData.media?.photosPage || {};
const description = page.subtitle || "Photos and visuals from our guidance posts and service explainers.";
const images = (page.images || []).filter((i) => i?.src);

const canonical = canonicalFromPath(siteData.brand.websiteUrl, "/en/photos/");
const meta = buildMeta({
  title: `Photos | ${siteData.brand.shortName}`,
  description:
    "Office and Google posts photos from our Sholavaram base—real local context for customers in Chennai North & NH corridors.",
  canonical,
  ogType: "website",  geo: geoMetaFromBrand(siteData),});

const jsonLd = buildJsonLd({
  pageType: "photos",
  siteData,
  canonical,
  title: meta.title,
  description: meta.description,
  breadcrumbs: [
    { name: "Home", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/") },
    { name: "Photos", href: canonical },
  ],
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/styles/theme.css" />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <main class="app">
      <div class="container">

        <!-- ========================= DESKTOP ========================= -->
                <!-- SINGLE DOM: merged; divergent blocks remain per-breakpoint via ui-desktop/ui-mobile -->
        <div class="ui-desktop">
          <header>
            <DesktopHero brand={{
              name: brand.name,
              tagline: brand.tagline,
              subtitle: brand.subtitle,
              phone: brand.phone,
              areaChips: brand.areaChips,
            }} />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: "Photos" },
          ]} />
        </div>

        <div class="ui-mobile">
          <header>
            <MobileHero brand={{
              name: brand.name,
              tagline: brand.tagline,
              subtitle: brand.subtitle,
              phone: brand.phone,
              areaChips: [],
            }} />
          </header>
        </div>

<section class="section section-padding" aria-labelledby="photos-title">
            <h1 id="photos-title" class="section-title">{page.title || "Photos"}</h1>
            <p class="section-sub readable">{description}</p>
            <PageActionBar brand={brand} context="Photos" />
          </section>

<div class="ui-desktop">
<!-- Not sure what you need? -->
          <section class="section section-padding" aria-label="Not sure what you need">
            <h2 class="section-title">Looking for something specific?</h2>
            <p class="section-sub readable">These photos are from our Google Business Profile posts. If you need insurance help, try one of these:</p>
            <div class="grid grid-2">
              <a class="card lg-card lg-card--0" href={EN("/insurance-near-me/")}>
                <h3 class="card-title">I need insurance help nearby</h3>
                <p class="card-desc">How local support works — visit vs WhatsApp/phone.</p>
              </a>
              <a class="card lg-card lg-card--1" href={EN("/services/")}>
                <h3 class="card-title">Browse all services</h3>
                <p class="card-desc">Transport, industrial, construction, business & personal insurance.</p>
              </a>
              <a class="card lg-card lg-card--2" href={EN("/reviews/")}>
                <h3 class="card-title">Read customer reviews</h3>
                <p class="card-desc">Verified Google Business Profile reviews.</p>
              </a>
              <a class="card lg-card lg-card--3" href={EN("/faqs/")}>
                <h3 class="card-title">Read FAQs</h3>
                <p class="card-desc">Common questions about renewals, claims, documents & coverage.</p>
              </a>
            </div>
          </section>
        </div>

<div class="ui-mobile">
<section class="section section-padding">
            <h2 class="section-title">Looking for something specific?</h2>
            <div class="grid grid-1">
              <a class="card lg-card lg-card--0" href={EN("/insurance-near-me/")}>
                <h3 class="card-title">I need insurance help nearby</h3>
                <p class="card-desc">How local support works.</p>
              </a>
              <a class="card lg-card lg-card--1" href={EN("/services/")}>
                <h3 class="card-title">Browse all services</h3>
                <p class="card-desc">Transport, industrial, construction & personal insurance.</p>
              </a>
            </div>
          </section>
        </div>

<!-- Photo gallery -->
          <section class="section section-padding" aria-label="Photo gallery">
            <h2 class="section-title">Photo gallery</h2>
            <ul class="photo-grid" role="list" aria-label="Photo gallery">
              {images.map((img) => {
                const shape = img.shape || "landscape";
                return (
                  <li class={`ph ${shape}`}>
                    <a href={img.src} target="_blank" rel="noopener" class="ph-link" aria-label={img.alt || "Photo"}>
                      <img src={img.src} alt={img.alt || "Photo"} loading="lazy" decoding="async" />
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>

<ConversionBlock siteData={siteData} brand={brand} />

<div class="ui-desktop">
<!-- USER QUESTIONS -->
          <UserQuestionsBlock
            title="Quick answers before you contact us"
            items={cc.userQuestions || []}
          />
<!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />
        </div>

<BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

<section aria-label="Contact CTA">
            <FooterCtaBar
              title={siteData.footerCtas.title}
              subtitle={siteData.footerCtas.subtitle}
              whatsappNumber={brand.whatsappE164}
              whatsappText={brand.whatsappPrefill}
              callNumber={brand.phoneE164}
              callLabel={siteData.footerCtas.callLabel}
              brandName={siteData.footerCtas.brandName}
              logoText={siteData.footerCtas.logoText}
              copyright={siteData.footerCtas.copyright}
            />
          </section>
      </div>
    </main>

    <GlobalOverlays />
  
    <style is:global>
      /* Single-DOM merge: hide desktop-only extras below the existing 820px switch */
      @media (max-width: 820px){
        .swh > .section-sub{display:none}
        .swh-grid > .swh-card:nth-child(n+3){display:none}
        .tgf > .section-sub{display:none}
        .tgf-list > .tgf-item:nth-child(n+4){display:none}
      }
    </style>
  </body>
</html>

<style is:global>
  .readable{max-width:78ch}
  .grid{display:grid;gap:12px}
  .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid-1{grid-template-columns:1fr}
  .card{display:block;padding:14px;border:1px solid rgba(255,255,255,.12);border-radius:14px;text-decoration:none}
  .card-title{font-size:16px;margin:8px 0 6px}
  .card-desc{margin:0;opacity:.85}

  .photo-grid{
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 10px;
  }
  .ph{
    grid-column: span 12;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 2px 10px rgba(11,13,18,.05);
    overflow: hidden;
  }
  @media (min-width: 720px){ .ph{ grid-column: span 6; } }
  @media (min-width: 1024px){ .ph{ grid-column: span 4; } }
  .ph-link{ display:block; padding: 10px; }
  .ph img{
    width: 100%;
    height: auto;
    display:block;
    object-fit: contain;
    background: transparent;
    border-radius: 12px;
  }
  @media(max-width:980px){.grid-2{grid-template-columns:1fr}}
</style>
