---
// src/pages/en/seasonal/[seasonalSlug]/index.astro
// Seasonal / calendar-driven insurance pages
// FY end/start, monsoon, mid-year, year-end, tax deadlines

import DesktopHero from "../../../../components/DesktopHero.astro";
import MobileHero from "../../../../components/MobileHero.astro";
import MobileAccordion from "../../../../components/MobileAccordion.astro";
import FooterCtaBar from "../../../../components/FooterCtaBar.astro";
import GlobalOverlays from "src/components/GlobalOverlays.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import Breadcrumbs from "src/components/Breadcrumbs.astro";
import BacklinksRow from "src/components/BacklinksRow.astro";

import { siteData, EN } from "../../../../content/siteData";
import { canonicalFromPath, buildMeta, buildJsonLd, geoMetaFromBrand } from "../../../../lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";
import UserQuestionsBlock from "src/components/UserQuestionsBlock.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";

export async function getStaticPaths() {
  return Object.keys(siteData.seasonalPages).map(slug => ({
    params: { seasonalSlug: slug },
  }));
}

const { seasonalSlug } = Astro.params;
const page = siteData.seasonalPages[seasonalSlug];
if (!page) throw new Error(`Missing siteData.seasonalPages['${seasonalSlug}']`);

const cc = siteData.confidenceContent || {};
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");

const canonical = canonicalFromPath(siteData.brand.websiteUrl, `/en/seasonal/${seasonalSlug}/`);
const meta = buildMeta({
  title: `${page.seoTitle} | ${siteData.brand.name}`,
  description: page.seoDesc,
  canonical,
  geo: geoMetaFromBrand(siteData),
});

const jsonLd = buildJsonLd({
  pageType: "intent",
  canonical,
  siteData,
  title: meta.title,
  description: meta.description,
  breadcrumbs: [
    { name: "Home", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/") },
    { name: "Seasonal", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/seasonal/") },
    { name: seasonalSlug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '), href: canonical },
  ],
  serviceData: page,
  faqs: page.faqs || [],
});

const urgencyClass = page.urgency === "high" ? "urgency-high" : "urgency-medium";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={meta.canonical} />
    <link rel="stylesheet" href="/styles/theme.css" />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <main class="app">
      <div class="container">

        <!-- ========================= DESKTOP ========================= -->
        <div class="ui-desktop">
          <header>
            <DesktopHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: page.heroP,
              phone: siteData.brand.phone,
              areaChips: siteData.brand.areaChips,
            }} />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: "Seasonal", href: EN("/seasonal/") },
            { label: page.heroH1 },
          ]} />

          <!-- Season tag + urgency badge -->
          <section class="section section-padding">
            <div class="season-badge-row">
              <span class={`season-tag ${urgencyClass}`}>{page.seasonTag}</span>
              {page.urgency === "high" && <span class="urgency-badge">⏰ Act Now</span>}
            </div>
            <h1 class="section-title">{page.heroH1}</h1>
            <p class="section-sub readable">{page.heroP}</p>
            <PageActionBar brand={siteData.brand} context={page.heroH1 || ""} />
          </section>

          <!-- Why act now -->
          {page.whyNow?.length ? (
            <section class="section section-padding" aria-label="Why act now">
              <h2 class="section-title">Why you need to act now</h2>
              <ul class="why-now-list">
                {page.whyNow.map((item) => (
                  <li class="why-now-item">{item}</li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- Who this helps -->
          {page.whoThisHelps?.length ? (
            <section class="section section-padding" aria-label="Who this helps">
              <h2 class="section-title">Who this helps</h2>
              <ul class="bullets">{page.whoThisHelps.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- Action checklist -->
          {page.actionChecklist?.length ? (
            <section class="section section-padding" aria-label="Action checklist">
              <h2 class="section-title">Your action checklist</h2>
              <ul class="checklist-grid" role="list">
                {page.actionChecklist.map((item, i) => (
                  <li class="checklist-item">
                    <span class="checklist-num">{i + 1}</span>
                    <div>
                      <h3 class="checklist-title">{item.title}</h3>
                      <p class="checklist-text">{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- What you get -->
          {page.whatYouGet?.length ? (
            <section class="section section-padding" aria-label="What you get">
              <h2 class="section-title">What you get from us</h2>
              <ul class="bullets">{page.whatYouGet.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- How support works -->
          {page.howSupportWorks?.length ? (
            <section class="section section-padding" aria-label="How support works">
              <h2 class="section-title">How we support you</h2>
              <ul class="area-rows" role="list">
                {page.howSupportWorks.map((s) => (
                  <li class="area-row">
                    <h3 class="area-name">{s.title}</h3>
                    <p class="area-notes">{s.text}</p>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- MID-PAGE CTA -->
          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <!-- USER QUESTIONS -->
          <UserQuestionsBlock
            title="Common questions before you contact us"
            items={cc.userQuestions || []}
          />

          <!-- SMART ASSIST -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-desk"
            heading="Ready to reach out? Pre-fill your WhatsApp in 30 seconds"
            subheading="Pick your situation — we build the message, you just send."
          />

          <!-- SCENARIOS WE HANDLE -->
          <ScenariosWeHandle
            title="Real situations we handle"
            subtitle="People reach us with exactly these kinds of situations."
            scenarios={(cc.homeScenarios || []).slice(0, 3)}
            waNumber={waNumber}
          />

          <!-- Recommended services -->
          {page.recommendedServices?.length ? (
            <section class="section section-padding" aria-label="Recommended pages">
              <h2 class="section-title">Recommended services</h2>
              <div class="grid grid-2">
                {page.recommendedServices.map((x) => (
                  <a class="card" href={x.href}>
                    <h3 class="card-title">{x.label}</h3>
                    <p class="card-desc">Coverage, documents & guidance</p>
                  </a>
                ))}
              </div>
            </section>
          ) : null}

          <!-- STILL WONDERING -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={(cc.homeGapQuestions || []).slice(0, 4)}
            waNumber={waNumber}
            waText={`Hi, I need help with ${page.heroH1 || 'insurance'}. Can you guide me?`}
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <!-- FAQs -->
          {page.faqs?.length ? (
            <section class="section section-padding" aria-label="FAQs">
              <h2 class="section-title">Frequently asked questions</h2>
              <MobileAccordion
                sections={[{
                  title: "Questions people ask",
                  items: page.faqs.map((f) => ({ strong: f.q, text: f.a })),
                }]}
                defaultOpen={true}
              />
            </section>
          ) : null}

          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>

        <!-- ========================= MOBILE ========================= -->
        <div class="ui-mobile">
          <header>
            <MobileHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: page.heroP,
              phone: siteData.brand.phone,
              areaChips: [],
            }} />
          </header>

          <!-- Season tag + H1 -->
          <section class="section section-padding">
            <div class="season-badge-row">
              <span class={`season-tag ${urgencyClass}`}>{page.seasonTag}</span>
              {page.urgency === "high" && <span class="urgency-badge">⏰ Act Now</span>}
            </div>
            <h1 class="section-title">{page.heroH1}</h1>
            <p class="section-sub readable">{page.heroP}</p>
            <PageActionBar brand={siteData.brand} context={page.heroH1 || ""} />
          </section>

          <!-- Why act now -->
          {page.whyNow?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Why you need to act now</h2>
              <ul class="why-now-list">
                {page.whyNow.map((item) => (
                  <li class="why-now-item">{item}</li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- Who this helps -->
          {page.whoThisHelps?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Who this helps</h2>
              <ul class="bullets">{page.whoThisHelps.map((x) => <li>{x}</li>)}</ul>
            </section>
          ) : null}

          <!-- Action checklist -->
          {page.actionChecklist?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">Your action checklist</h2>
              <ul class="checklist-grid" role="list">
                {page.actionChecklist.map((item, i) => (
                  <li class="checklist-item">
                    <span class="checklist-num">{i + 1}</span>
                    <div>
                      <h3 class="checklist-title">{item.title}</h3>
                      <p class="checklist-text">{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- How support works -->
          {page.howSupportWorks?.length ? (
            <section class="section section-padding">
              <h2 class="section-title">How we support you</h2>
              <ul class="area-rows" role="list">
                {page.howSupportWorks.map((s) => (
                  <li class="area-row">
                    <h3 class="area-name">{s.title}</h3>
                    <p class="area-notes">{s.text}</p>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}

          <!-- MID-PAGE CTA -->
          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <!-- USER QUESTIONS -->
          <UserQuestionsBlock
            title="Common questions before you contact us"
            items={cc.userQuestions || []}
          />

          <!-- SMART ASSIST -->
          <SmartAssistForm
            brand={siteData.brand}
            id="sa-mob"
            heading="Ready to reach out? Pre-fill your WhatsApp in 30 seconds"
            subheading="Pick your situation — we build the message, you just send."
          />

          <!-- SCENARIOS -->
          <ScenariosWeHandle
            title="Real situations we handle"
            scenarios={(cc.homeScenarios || []).slice(0, 2)}
            waNumber={waNumber}
          />

          <!-- STILL WONDERING -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={(cc.homeGapQuestions || []).slice(0, 3)}
            waNumber={waNumber}
            waText={`Hi, I need help with ${page.heroH1 || 'insurance'}. Can you guide me?`}
          />

          <!-- FAQs -->
          {page.faqs?.length ? (
            <section class="section section-padding">
              <MobileAccordion
                sections={[{
                  title: "FAQs",
                  items: page.faqs.map((f) => ({ strong: f.q, text: f.a })),
                }]}
                defaultOpen={true}
              />
            </section>
          ) : null}

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <ConversionBlock siteData={siteData} brand={siteData.brand} />

          <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

          <FooterCtaBar
            title={siteData.footerCtas.title}
            subtitle={siteData.footerCtas.subtitle}
            whatsappNumber={siteData.brand.whatsappE164}
            whatsappText={siteData.brand.whatsappPrefill}
            callNumber={siteData.brand.phoneE164}
            callLabel={siteData.footerCtas.callLabel}
            brandName={siteData.footerCtas.brandName}
            logoText={siteData.footerCtas.logoText}
            copyright={siteData.footerCtas.copyright}
          />
        </div>

      </div>
    </main>

    <GlobalOverlays />

    <style is:global>
      .readable{max-width:78ch}
      .grid{display:grid;gap:12px}
      .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
      .card{display:block;padding:14px;border:1px solid rgba(255,255,255,.12);border-radius:14px;text-decoration:none}
      .card-title{font-size:16px;margin:8px 0 6px}
      .card-desc{margin:0;opacity:.85}
      .inline-link{font-weight:900;text-decoration:underline;text-underline-offset:3px}
      .area-rows{margin:14px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px}
      .area-row{border:1px solid var(--border);border-radius:18px;background:var(--surface);box-shadow:0 2px 10px rgba(11,13,18,.05);padding:12px 14px}
      .area-name{margin:0;font-size:15px;font-weight:950;letter-spacing:-0.01em}
      .area-notes{margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.4}

      /* Seasonal-specific styles */
      .season-badge-row{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
      .season-tag{display:inline-block;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;letter-spacing:.02em;background:rgba(59,130,246,.15);color:#60a5fa;border:1px solid rgba(59,130,246,.3)}
      .urgency-high{background:rgba(239,68,68,.15);color:#f87171;border-color:rgba(239,68,68,.3)}
      .urgency-medium{background:rgba(234,179,8,.15);color:#facc15;border-color:rgba(234,179,8,.3)}
      .urgency-badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:800;background:rgba(239,68,68,.2);color:#f87171;animation:pulse-urgency 2s ease-in-out infinite}
      @keyframes pulse-urgency{0%,100%{opacity:1}50%{opacity:.6}}

      .why-now-list{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:10px}
      .why-now-item{padding:12px 16px;border-left:3px solid #f87171;background:rgba(239,68,68,.06);border-radius:0 12px 12px 0;font-size:14px;line-height:1.5}

      .checklist-grid{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:12px}
      .checklist-item{display:flex;gap:14px;align-items:flex-start;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}
      .checklist-num{flex-shrink:0;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(59,130,246,.15);color:#60a5fa;font-weight:900;font-size:14px}
      .checklist-title{margin:0;font-size:15px;font-weight:900}
      .checklist-text{margin:6px 0 0;font-size:13px;color:var(--muted);line-height:1.45}

      @media (max-width:980px){.grid-2{grid-template-columns:1fr}}
    </style>
  </body>
</html>
