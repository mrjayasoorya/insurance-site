---
// src/pages/en/[intentSlug]/index.astro
// RESTRUCTURED: Added Breadcrumbs, howWeWork, tightened section order

import DesktopHero from "../../../components/DesktopHero.astro";
import MobileHero from "../../../components/MobileHero.astro";
import MobileAccordion from "../../../components/MobileAccordion.astro";
import FooterCtaBar from "../../../components/FooterCtaBar.astro";
import GlobalOverlays from "src/components/GlobalOverlays.astro";
import PageActionBar from "src/components/PageActionBar.astro";
import Breadcrumbs from "src/components/Breadcrumbs.astro";
import BacklinksRow from "src/components/BacklinksRow.astro";

import { siteData, EN } from "../../../content/siteData";
import { canonicalFromPath, buildMeta, buildJsonLd, geoMetaFromBrand } from "../../../lib/seo";
import ConversionBlock from "src/components/ConversionBlock.astro";
import ScenariosWeHandle from "src/components/ScenariosWeHandle.astro";
import ThinkingGapFiller from "src/components/ThinkingGapFiller.astro";
import WhyChooseUs from "src/components/WhyChooseUs.astro";
import UserQuestionsBlock from "src/components/UserQuestionsBlock.astro";
import SmartAssistForm from "src/components/SmartAssistForm.astro";

export async function getStaticPaths() {
  const EXCLUDED = new Set([
    "insurance-near-me",
    "insurance-renewal-near-me",
    "insurance-claim-help",
    "buy-insurance-guidance",
    "remote-insurance-support",
    "spot-insurance-support",
  ]);
  return Object.keys(siteData.intentPages)
    .filter(slug => !EXCLUDED.has(slug))
    .map(slug => ({ params: { intentSlug: slug } }));
}

const { intentSlug } = Astro.params;
const page = siteData.intentPages[intentSlug];
if (!page) throw new Error(`Missing siteData.intentPages['${intentSlug}']`);

// Confidence content
const cc = siteData.confidenceContent || {};
const waNumber = (siteData.brand.whatsappE164 || "").replace("+", "");

const canonical = canonicalFromPath(siteData.brand.websiteUrl, `/en/${intentSlug}/`);
const meta = buildMeta({
  title: `${page.seoTitle} | ${siteData.brand.shortName}`,
  description: page.seoDesc,
  canonical,
  geo: geoMetaFromBrand(siteData),
});

const jsonLd = buildJsonLd({
  pageType: "intent",
  canonical,
  siteData,
  title: meta.title,
  description: meta.description,
  breadcrumbs: [
    { name: "Home", href: canonicalFromPath(siteData.brand.websiteUrl, "/en/") },
    { name: intentSlug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' '), href: canonical },
  ],
  serviceData: page,
  faqs: page.faqs || [],
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={meta.canonical} />
    <link rel="stylesheet" href="/styles/theme.css" />
    <link rel="icon" type="image/png" href="/assets/logo/MNRajendraKumar_Insurance_services_logo_48x48px_white_bg_icon.png"/>
    {Object.entries(meta.tags).map(([k, v]) => <meta property={k} content={v} />)}
    {Object.entries(meta.nameTags || {}).map(([k, v]) => <meta name={k} content={v} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <main class="app">
      <div class="container">
        <!-- SINGLE DOM: hero variants switch at 820px (existing .ui-desktop/.ui-mobile breakpoint);
             all content below renders once. Mobile differences reproduced via CSS at 820px. -->
        <div class="ui-desktop">
          <header>
            <DesktopHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: page.heroP,
              phone: siteData.brand.phone,
              areaChips: siteData.brand.areaChips,
            }} />
          </header>

          <Breadcrumbs items={[
            { label: "Home", href: EN("/") },
            { label: page.heroH1 },
          ]} />
        </div>

        <div class="ui-mobile">
          <header>
            <MobileHero brand={{
              name: siteData.brand.name,
              tagline: siteData.brand.tagline,
              subtitle: page.heroP,
              phone: siteData.brand.phone,
              areaChips: [],
            }} />
          </header>
        </div>

        <!-- 1. H1 + CTA -->
        <section class="section section-padding">
          <h1 class="section-title">{page.heroH1}</h1>
          <p class="section-sub readable">{page.heroP}</p>
          <PageActionBar brand={siteData.brand} context={page.heroH1 || ""} />
        </section>

        <!-- 2. Who this helps -->
        {page.whoThisHelps?.length ? (
          <section class="section section-padding" aria-label="Who this helps">
            <h2 class="section-title">Who this helps</h2>
            <ul class="bullets">{page.whoThisHelps.map((x) => <li>{x}</li>)}</ul>
          </section>
        ) : null}

        <!-- 3. What you get (desktop-only, as before) -->
        {page.whatYouGet?.length ? (
          <div class="ui-desktop">
            <section class="section section-padding" aria-label="What you get">
              <h2 class="section-title">What you get</h2>
              <ul class="bullets">{page.whatYouGet.map((x) => <li>{x}</li>)}</ul>
            </section>
          </div>
        ) : null}

        <!-- 4. How support works -->
        {page.howSupportWorks?.length ? (
          <section class="section section-padding" aria-label="How support works">
            <h2 class="section-title">How support works</h2>
            <ul class="area-rows" role="list">
              {page.howSupportWorks.map((s) => (
                <li class="area-row">
                  <h3 class="area-name">{s.title}</h3>
                  <p class="area-notes">{s.text}</p>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <!-- 4b. Who you are — persona-specific guidance -->
        {page.personaGuide?.length ? (
          <section class="section section-padding" aria-label="Guidance by situation">
            <h2 class="section-title">{page.personaGuideTitle || "Find your situation"}</h2>
            <div class="persona-grid">
              {page.personaGuide.map((p) => (
                <div class="persona-card">
                  <h3 class="persona-heading">{p.label}</h3>
                  {p.forWhom ? <p class="persona-sub readable">{p.forWhom}</p> : null}
                  <ul class="bullets">{p.points.map((pt) => <li>{pt}</li>)}</ul>
                  {p.waText && waNumber ? (
                    <a class="persona-cta" href={`https://wa.me/${waNumber}?text=${encodeURIComponent(p.waText)}`} target="_blank" rel="noopener">
                      {p.ctaLabel || "WhatsApp about this"}
                    </a>
                  ) : null}
                </div>
              ))}
            </div>
          </section>
        ) : null}

        <!-- 4c. Comparison table (scroll wrapper always present; min-width applies below 820px only) -->
        {page.comparisonTable?.rows?.length ? (
          <section class="section section-padding" aria-label="Comparison">
            <h2 class="section-title">{page.comparisonTable.title || "How this compares"}</h2>
            {page.comparisonTable.intro ? <p class="readable">{page.comparisonTable.intro}</p> : null}
            <div class="compare-scroll" style="overflow-x:auto">
              <table class="compare-table">
                <thead>
                  <tr class="compare-header">
                    {page.comparisonTable.columns.map((c, i) => (
                      <th class={`compare-cell ${i === 0 ? "compare-k" : ""} ${i === page.comparisonTable.columns.length - 1 ? "compare-us" : ""}`} scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {page.comparisonTable.rows.map((r) => (
                    <tr class="compare-row">
                      {r.map((cell, i) => (
                        i === 0
                          ? <th class="compare-cell compare-k" scope="row">{cell}</th>
                          : <td class={`compare-cell ${i === r.length - 1 ? "compare-us" : ""}`}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ) : null}

        <!-- 4d. Deeper guide sections -->
        {page.guideSections?.length ? (
          page.guideSections.map((g) => (
            <section class="section section-padding" aria-label={g.title}>
              <h2 class="section-title">{g.title}</h2>
              {g.intro ? <p class="readable">{g.intro}</p> : null}
              {g.points?.length ? <ul class="bullets" style="margin-top:12px">{g.points.map((x) => <li>{x}</li>)}</ul> : null}
            </section>
          ))
        ) : null}

        <!-- USER QUESTIONS -->
        <UserQuestionsBlock
          title="Common questions before you contact us"
          items={cc.userQuestions || []}
        />

        <!-- SMART ASSIST — ready to reach out -->
        <SmartAssistForm
          brand={siteData.brand}
          id="sa-desk"
          heading="Ready to reach out? Pre-fill your WhatsApp in 30 seconds"
          subheading="Pick your situation — we build the message, you just send."
        />

        <!-- SCENARIOS WE HANDLE: 3 in DOM; 3rd + subtitle hidden below 820px (was mobile slice(0,2)) -->
        <ScenariosWeHandle
          title="Real situations we handle"
          subtitle="People reach us with exactly these kinds of situations."
          scenarios={(page.scenarios?.length ? page.scenarios : (cc.homeScenarios || [])).slice(0, 3)}
          waNumber={waNumber}
        />

        <!-- 7. Recommended services (desktop-only, as before) -->
        {page.recommendedServices?.length ? (
          <div class="ui-desktop">
            <section class="section section-padding" aria-label="Recommended pages">
              <h2 class="section-title">Recommended services</h2>
              <div class="grid grid-2">
                {page.recommendedServices.map((x, i) => (
                  <a class={`card lg-card lg-card--${i % 4}`} href={x.href}>
                    <h3 class="card-title">{x.label}</h3>
                    <p class="card-desc">Coverage, documents & guidance</p>
                  </a>
                ))}
              </div>
            </section>
          </div>
        ) : null}

        <!-- Tail: desktop order TGF -> WhyChooseUs -> FAQs; mobile order TGF -> FAQs -> WhyChooseUs
             (reproduced with CSS `order` below 820px — same DOM). -->
        <div class="tail-swap">
          <!-- STILL WONDERING: 4 in DOM; 4th hidden below 820px (was mobile slice(0,3)) -->
          <ThinkingGapFiller
            title="Still wondering?"
            items={(cc.homeGapQuestions || []).slice(0, 4)}
            waNumber={waNumber}
            waText={`Hi, I need help with ${page.heroH1 || 'insurance'}. Can you guide me?`}
          />

          <!-- WHY CHOOSE US -->
          <WhyChooseUs
            title="Why work with us"
            points={(cc.whyUs || []).slice(0, 4)}
          />

          <!-- 8. FAQs (desktop h2 hidden on mobile; accordion group label unified to "FAQs") -->
          {page.faqs?.length ? (
            <section class="faq-sec section section-padding" aria-label="FAQs">
              <div class="ui-desktop">
                <h2 class="section-title">Frequently asked questions</h2>
              </div>
              <MobileAccordion
                sections={[{
                  title: "FAQs",
                  items: page.faqs.map((f) => ({ strong: f.q, text: f.a })),
                }]}
                defaultOpen={true}
              />
            </section>
          ) : null}
        </div>

        <ConversionBlock siteData={siteData} brand={siteData.brand} />

        <BacklinksRow title={siteData.backlinks.title} links={siteData.backlinks.links} />

        <FooterCtaBar
          title={siteData.footerCtas.title}
          subtitle={siteData.footerCtas.subtitle}
          whatsappNumber={siteData.brand.whatsappE164}
          whatsappText={siteData.brand.whatsappPrefill}
          callNumber={siteData.brand.phoneE164}
          callLabel={siteData.footerCtas.callLabel}
          brandName={siteData.footerCtas.brandName}
          logoText={siteData.footerCtas.logoText}
          copyright={siteData.footerCtas.copyright}
        />

      </div>
    </main>

    <GlobalOverlays />

    <style is:global>
      .readable{max-width:78ch}
      .grid{display:grid;gap:12px}
      .grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
      .grid-1{grid-template-columns:1fr}
      .card{display:block;padding:14px;border:1px solid rgba(255,255,255,.12);border-radius:14px;text-decoration:none}
      .card-title{font-size:16px;margin:8px 0 6px}
      .card-desc{margin:0;opacity:.85}
      .inline-link{font-weight:900;text-decoration:underline;text-underline-offset:3px}
      .area-rows{margin:14px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px}
      .area-row{border:1px solid var(--border);border-radius:18px;background:var(--surface);box-shadow:0 2px 10px rgba(11,13,18,.05);padding:12px 14px}
      .area-name{margin:0;font-size:15px;font-weight:950;letter-spacing:-0.01em}
      .area-notes{margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.4}
      @media (max-width: 980px){.grid-2{grid-template-columns:1fr}}

      .persona-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-top:16px}
      .persona-card{border:1px solid var(--border);border-radius:16px;background:var(--surface);padding:16px;display:flex;flex-direction:column;gap:8px}
      .persona-heading{margin:0;font-size:16px;font-weight:950;letter-spacing:-0.01em}
      .persona-sub{margin:0;font-size:13px;opacity:.8}
      .persona-cta{margin-top:auto;display:inline-block;padding:9px 14px;border-radius:10px;background:#25D366;color:#0b0d12;font-weight:800;font-size:13px;text-decoration:none;text-align:center}

      .compare-table{width:100%;border:1px solid var(--border);border-radius:12px;overflow:hidden;border-collapse:collapse}
      .compare-header, .compare-row{display:table-row}
      .compare-header{background:var(--surface);font-weight:900;font-size:13px}
      .compare-row{border-top:1px solid var(--border)}
      .compare-cell{display:table-cell;padding:10px 12px;font-size:13px;line-height:1.35;text-align:left;font-weight:400}
      .compare-k{font-weight:700;opacity:.85}
      .compare-us{background:rgba(46,125,50,.06);font-weight:600}
      @media (max-width:520px){.compare-header{font-size:11px}.compare-cell{padding:8px 6px}}

      /* Single-DOM merge: reproduce previous mobile tree at the existing 820px switch */
      @media (min-width: 821px){
        .compare-scroll{margin-top:16px}
      }
      @media (max-width: 820px){
        .swh > .section-sub{display:none}
        .swh-grid > .swh-card:nth-child(3){display:none}
        .tgf-list > .tgf-item:nth-child(4){display:none}
        .compare-scroll .compare-table{min-width:480px;margin-top:16px}
        .tail-swap{display:flex;flex-direction:column}
        .tail-swap > .tgf{order:1}
        .tail-swap > .faq-sec{order:2}
        .tail-swap > .wcu{order:3}
      }
    </style>
  </body>
</html>
